  <!-- ===== Help topic descriptions (Admin) ===== -->
  <data name="Help.Desc.Dashboard" xml:space="preserve"><value>Summary of the barangay's key figures and activity (residents, requests, reports).</value></data>
  <data name="Help.Desc.Residents" xml:space="preserve"><value>Manage resident records — add, edit, and search residents.</value></data>
  <data name="Help.Desc.Certificates" xml:space="preserve"><value>Process certificate requests and manage certificate types + dynamic requirements.</value></data>
  <data name="Help.Desc.Complaints" xml:space="preserve"><value>Receive and handle resident complaints.</value></data>
  <data name="Help.Desc.Messages" xml:space="preserve"><value>Inbox of messages sent through the public Contact form. Shows an unread badge in the sidebar and header.</value></data>
  <data name="Help.Desc.Projects" xml:space="preserve"><value>Track barangay projects and their status.</value></data>
  <data name="Help.Desc.Budget" xml:space="preserve"><value>Record the barangay's budget, funds, and expenses.</value></data>
  <data name="Help.Desc.Disaster" xml:space="preserve"><value>Manage disaster incidents, evacuation centers/status, and Emergency SMS alerts.</value></data>
  <data name="Help.Desc.Health" xml:space="preserve"><value>Barangay health records and health services.</value></data>
  <data name="Help.Desc.Environment" xml:space="preserve"><value>Activities and programs for the environment and sanitation.</value></data>
  <data name="Help.Desc.Officials" xml:space="preserve"><value>Manage Barangay and SK officials — profile, committee, and service history. Includes structure validation (limits, unique names/committees).</value></data>
  <data name="Help.Desc.Announcements" xml:space="preserve"><value>Post and manage announcements for the public.</value></data>
  <data name="Help.Desc.Reports" xml:space="preserve"><value>Generate reports/summaries from barangay data.</value></data>
  <data name="Help.Desc.Users" xml:space="preserve"><value>Manage user accounts and roles (Admin/Staff).</value></data>
  <data name="Help.Desc.Settings" xml:space="preserve"><value>Configuration such as certificate templates and system settings.</value></data>
  <data name="Help.Desc.StaffDashboard" xml:space="preserve"><value>Summary of the tasks and data accessible to Staff/Encoder.</value></data>
  <data name="Help.Desc.StaffResidents" xml:space="preserve"><value>Encode and update resident records.</value></data>
  <data name="Help.Desc.StaffCertificates" xml:space="preserve"><value>Encode and process residents' certificate requests.</value></data>
  <data name="Help.Desc.StaffComplaints" xml:space="preserve"><value>Receive and log resident complaints.</value></data>
  <data name="Help.Desc.StaffDisaster" xml:space="preserve"><value>Encode disaster incidents and locations for the barangay records.</value></data>
