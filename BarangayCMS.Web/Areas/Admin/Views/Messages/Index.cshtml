@using BarangayCMS.DTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<BarangayCMS.DTO.ContactMessageDTO>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Messages";

    var status = ViewBag.Status as string ?? "All";
    var query = ViewBag.Query as string ?? "";
    var from = ViewBag.From as string ?? "";
    var to = ViewBag.To as string ?? "";

    int total = ViewBag.TotalCount ?? 0;
    int unread = ViewBag.UnreadCount ?? 0;
    int readc = ViewBag.ReadCount ?? 0;
    int replied = ViewBag.RepliedCount ?? 0;
    int archived = ViewBag.ArchivedCount ?? 0;

    string StatusBadge(string s) => s switch
    {
        "Replied" => "bg-success-subtle text-success border border-success-subtle",
        "Read" => "bg-info-subtle text-info border border-info-subtle",
        "Archived" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        _ => "bg-warning-subtle text-warning-emphasis border border-warning-subtle"
    };
}

<style>
    .stat-tile { border: none; border-radius: .9rem; cursor: pointer; transition: transform .12s ease, box-shadow .12s ease; }
    .stat-tile:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15,23,42,.10); }
    .stat-tile.active { outline: 2px solid #2563eb; }
    tr.is-unread { background: #f5f8ff; }
    tr.is-unread td:first-child { border-left: 4px solid #2563eb; }
    .status-pill { font-size: .72rem; font-weight: 600; padding: .28rem .6rem; border-radius: 999px; white-space: nowrap; }
    .msg-cell { max-width: 340px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-inbox-fill text-primary me-2"></i>Messages
            @if (unread > 0)
            {
                <span class="badge rounded-pill bg-danger align-middle">Unread: @unread</span>
            }
        </h2>
        <p class="text-muted small mb-0">Mga mensaheng ipinadala mula sa <span class="fw-semibold">Contact Us</span> page ng publiko.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- STAT / FILTER TILES -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a href="/Admin/Messages?status=All" class="text-decoration-none text-reset">
            <div class="card stat-tile shadow-sm @(status == "All" ? "active" : "")">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-collection-fill fs-3 text-secondary"></i>
                    <div><div class="h4 fw-bold mb-0">@total</div><div class="small text-muted">Lahat</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="/Admin/Messages?status=Unread" class="text-decoration-none text-reset">
            <div class="card stat-tile shadow-sm @(status == "Unread" ? "active" : "")">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-envelope-fill fs-3 text-warning"></i>
                    <div><div class="h4 fw-bold mb-0">@unread</div><div class="small text-muted">Unread</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="/Admin/Messages?status=Read" class="text-decoration-none text-reset">
            <div class="card stat-tile shadow-sm @(status == "Read" ? "active" : "")">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-envelope-open-fill fs-3 text-info"></i>
                    <div><div class="h4 fw-bold mb-0">@readc</div><div class="small text-muted">Read</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="/Admin/Messages?status=Replied" class="text-decoration-none text-reset">
            <div class="card stat-tile shadow-sm @(status == "Replied" ? "active" : "")">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-reply-fill fs-3 text-success"></i>
                    <div><div class="h4 fw-bold mb-0">@replied</div><div class="small text-muted">Replied</div></div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- SEARCH / DATE FILTER -->
<div class="card border-0 shadow-sm rounded mb-4">
    <div class="card-body">
        <form method="get" action="/Admin/Messages" class="row g-2 align-items-end">
            <input type="hidden" name="status" value="@status" />
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Hanapin (contact number / mensahe)</label>
                <input type="text" name="q" value="@query" class="form-control form-control-sm" placeholder="Hal. 0912" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Mula</label>
                <input type="date" name="from" value="@from" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Hanggang</label>
                <input type="date" name="to" value="@to" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search me-1"></i>Filter</button>
                <a href="/Admin/Messages" class="btn btn-light btn-sm border" title="I-clear"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
        @if (archived > 0)
        {
            <div class="mt-2">
                <a href="/Admin/Messages?status=Archived" class="small text-decoration-none @(status == "Archived" ? "fw-bold" : "text-muted")">
                    <i class="bi bi-archive me-1"></i>Archived (@archived)
                </a>
            </div>
        }
    </div>
</div>

<!-- INBOX TABLE -->
<div class="card border-0 shadow-sm rounded">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Contact Number</th>
                    <th>Message</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="bi bi-inbox display-5 text-muted opacity-50 d-block mb-2"></i>
                            <span class="text-muted">Walang mensaheng tumutugma sa filter.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var m in Model)
                    {
                        var isUnread = m.Status == "Unread";
                        <tr class="@(isUnread ? "is-unread" : "")">
                            <td class="fw-@(isUnread ? "bold" : "semibold") text-nowrap">
                                @if (isUnread)
                                {
                                    <span class="badge rounded-pill bg-primary me-1" title="Bago"> </span>
                                }
                                <i class="bi bi-telephone me-1 text-secondary"></i>@m.ContactNumber
                            </td>
                            <td class="msg-cell text-muted small text-truncate">@m.MessagePreview</td>
                            <td class="small text-nowrap">@m.CreatedAt.ToString("MMM dd, yyyy")<br /><span class="text-muted">@m.CreatedAt.ToString("h:mm tt")</span></td>
                            <td><span class="status-pill @StatusBadge(m.Status)">@m.Status</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary btn-view" data-id="@m.Id">
                                    <i class="bi bi-eye me-1"></i>View
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- DETAIL MODAL (na-populate via AJAX) -->
<div class="modal fade" id="msgModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow" id="msgModalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted small mt-3 mb-0">Naglo-load ng mensahe...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('msgModal');
            var modalContent = document.getElementById('msgModalContent');
            var bsModal = new bootstrap.Modal(modalEl);

            document.querySelectorAll('.btn-view').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    modalContent.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border text-primary"></div><p class="text-muted small mt-3 mb-0">Naglo-load...</p></div>';
                    bsModal.show();
                    fetch('/Admin/Messages/Details/' + id, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(function (r) {
                            if (!r.ok) throw new Error('Hindi makuha ang mensahe.');
                            return r.text();
                        })
                        .then(function (html) { modalContent.innerHTML = html; })
                        .catch(function (err) {
                            modalContent.innerHTML = '<div class="modal-body"><div class="alert alert-danger mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>' + err.message + '</div></div>';
                        });
                });
            });
        })();
    </script>
}
