@using BarangayCMS.Web.Areas.Admin.Models
@model IEnumerable<SmsAlertHistoryItem>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "SMS Alert History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history text-secondary me-2"></i>SMS Alert History</h2>
        <p class="text-muted small mb-0">Kumpletong tala ng lahat ng naipadalang Emergency SMS alerts.</p>
    </div>
    <a asp-area="Admin" asp-controller="Disaster" asp-action="Index" class="btn btn-light border fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Back to Disaster Risk Management
    </a>
</div>

<div class="card border-0 shadow-sm rounded p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Date &amp; Time Sent</th>
                    <th>Emergency Type</th>
                    <th>Message</th>
                    <th>Recipient Group</th>
                    <th class="text-center">No. of Recipients</th>
                    <th class="text-center">Status</th>
                    <th>Sent By</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td>@h.SentAt.ToString("MM/dd/yyyy h:mm tt")</td>
                            <td class="fw-semibold">@h.EmergencyType</td>
                            <td><small class="text-truncate d-inline-block" style="max-width:320px;" title="@h.Message">@h.Message</small></td>
                            <td>@h.RecipientGroup</td>
                            <td class="text-center">
                                @h.RecipientCount
                                @if (h.FailedCount > 0)
                                {
                                    <br /><small class="text-muted">@h.SuccessCount ok / @h.FailedCount failed</small>
                                }
                            </td>
                            <td class="text-center">
                                @if (h.Status == "Sent")
                                {
                                    <span class="badge bg-success">Sent</span>
                                }
                                else if (h.Status == "Partial")
                                {
                                    <span class="badge bg-warning text-dark">Partial</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                            </td>
                            <td>@h.SentBy</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                            Wala pang naipadalang emergency SMS alert.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
