@model BarangayCMS.Web.Areas.Admin.Models.ResidentViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Register New Resident";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-person-plus-fill"></i> Register New Resident</h1>
        <p class="page-header__sub">Input complete demographic census data profiles into the database.</p>
    </div>
    <a href="/Admin/Residents" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Back to Roster</a>
</div>

<div class="app-card app-card--pad">
    <form asp-area="Admin" asp-controller="Residents" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- ROW 1: NAMES -->
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="FirstName" class="form-label fw-semibold">First Name</label>
                <input asp-for="FirstName" class="form-control text-capitalize" placeholder="e.g., Juan" oninput="autoCapitalizeWords(this)" required />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MiddleName" class="form-label fw-semibold">Middle Name</label>
                <input asp-for="MiddleName" class="form-control text-capitalize" placeholder="e.g., Ramos" oninput="autoCapitalizeWords(this)" />
                <span asp-validation-for="MiddleName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="LastName" class="form-label fw-semibold">Last Name</label>
                <input asp-for="LastName" class="form-control text-capitalize" placeholder="e.g., Dela Cruz" oninput="autoCapitalizeWords(this)" required />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <!-- ROW 2: DEMOGRAPHICS -->
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="Gender" class="form-label fw-semibold">Gender Selection</label>
                <select asp-for="Gender" class="form-select" required>
                    <option value="">Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="BirthDate" class="form-label fw-semibold">Date of Birth</label>
                <input asp-for="BirthDate" type="date" class="form-control" required />
                <span asp-validation-for="BirthDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CivilStatus" class="form-label fw-semibold">Civil Status</label>
                <select asp-for="CivilStatus" class="form-select">
                    <option value="">Select Status</option>
                    <option value="Single">Single</option>
                    <option value="Married">Married</option>
                    <option value="Widowed">Widowed</option>
                    <option value="Separated">Separated</option>
                </select>
                <span asp-validation-for="CivilStatus" class="text-danger small"></span>
            </div>
        </div>

        <!-- ROW 3: ADDRESS & PUROK / AREA & CONTACT -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="Address" class="form-label fw-semibold">House No. & Street Address</label>
                <input asp-for="Address" class="form-control text-capitalize" placeholder="e.g., #14 Ext. St." oninput="autoCapitalizeWords(this)" required />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Purok" class="form-label fw-semibold">Purok / Area / Sitio</label>
                <select asp-for="Purok" class="form-select" required>
                    <option value="">Select Area / Purok</option>
                    <option value="Area 1">Area 1</option>
                    <option value="Area 2">Area 2</option>
                    <option value="Area 3">Area 3</option>
                    <option value="Area 4">Area 4</option>
                    <option value="Area 5">Area 5</option>
                    <option value="Area 6">Area 6</option>
                    <option value="Area 7">Area 7</option>
                    <option value="Visayan Area">Visayan Area</option>
                    <option value="Tagalog Area">Tagalog Area</option>
                    <option value="Chicago / Ohio Area">Chicago / Ohio Area</option>
                    <option value="Block 245">Block 245</option>
                    <option value="Kalasag Area">Kalasag Area</option>
                    <option value="Kubo Area">Kubo Area</option>
                    <option value="BMA Area">BMA Area</option>
                </select>
                <span asp-validation-for="Purok" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ContactNumber" class="form-label fw-semibold">Contact Number</label>
                <input asp-for="ContactNumber"
                       class="form-control"
                       placeholder="e.g., 09123456789"
                       maxlength="11"
                       oninput="validatePhone11Digits(this)" />
                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
            </div>
        </div>

        <!-- 🧮 AUTO-COMPUTED DEMOGRAPHIC CLASSIFICATION PREVIEW -->
        <div class="p-3 rounded-3 border mb-3" style="background: var(--surface-alt);">
            <h6 class="fw-bold text-muted small text-uppercase mb-2"><i class="bi bi-calculator me-1"></i> Automatic Demographic Classification</h6>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-dark">Age: <span id="agePreview">—</span></span>
                <span class="badge bg-secondary" id="ageGroupPreview">Age Group: —</span>
                <span class="badge bg-info text-dark" id="youthPreview">Youth: —</span>
                <span class="badge bg-warning text-dark" id="seniorPreview">Senior: —</span>
            </div>
            <small class="text-muted d-block mt-2">Awtomatikong kinakalkula mula sa Date of Birth (Youth: 15–30, Senior: 60+).</small>
        </div>

        <!-- 🗳️ ROW 4: VOTER & PWD STATUS SWITCHES -->
        <div class="p-3 rounded-3 border mb-4" style="background: var(--surface-alt);">
            <div class="form-check form-switch d-flex align-items-center gap-2 m-0 mb-2">
                <input asp-for="IsVoter" class="form-check-input fs-5 mt-0" type="checkbox" id="IsVoterAdmin" style="cursor: pointer;">
                <label class="form-check-label fw-semibold" for="IsVoterAdmin" style="cursor: pointer;">
                    Rehistradong Botante sa Barangay na ito (Registered Voter)
                </label>
            </div>
            <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                <input asp-for="IsPwd" class="form-check-input fs-5 mt-0" type="checkbox" id="IsPwdAdmin" style="cursor: pointer;">
                <label class="form-check-label fw-semibold" for="IsPwdAdmin" style="cursor: pointer;">
                    Person With Disability (PWD)
                </label>
            </div>
        </div>

        <!-- FORM BUTTONS -->
        <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
            <a href="/Admin/Residents" class="btn btn-light border px-4">Cancel</a>
            <button type="submit" class="btn btn-brand px-4">
                <i class="bi bi-check-circle-fill me-1"></i> Complete Registration
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function autoCapitalizeWords(element) {
            let words = element.value.split(' ');
            for (let i = 0; i < words.length; i++) {
                if (words[i].length > 0) {
                    words[i] = words[i][0].toUpperCase() + words[i].substring(1).toLowerCase();
                }
            }
            element.value = words.join(' ');
        }

        function validatePhone11Digits(input) {
            input.value = input.value.replace(/[^0-9]/g, '');
            if (input.value.length > 11) {
                input.value = input.value.slice(0, 11);
            }
        }

        // 🧮 Live automatic Age + classification preview mula sa Date of Birth
        (function () {
            const dob = document.getElementById('BirthDate');
            const ageEl = document.getElementById('agePreview');
            const groupEl = document.getElementById('ageGroupPreview');
            const youthEl = document.getElementById('youthPreview');
            const seniorEl = document.getElementById('seniorPreview');
            if (!dob) return;

            function computeAge(birth) {
                const today = new Date();
                let age = today.getFullYear() - birth.getFullYear();
                const m = today.getMonth() - birth.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
                return age < 0 ? 0 : age;
            }

            function refresh() {
                if (!dob.value) { return; }
                const birth = new Date(dob.value);
                if (isNaN(birth.getTime())) { return; }
                const age = computeAge(birth);
                ageEl.textContent = age + ' yrs';

                let group = 'Adult (31-59)';
                if (age < 15) group = 'Child (0-14)';
                else if (age <= 30) group = 'Youth (15-30)';
                else if (age >= 60) group = 'Senior (60+)';
                groupEl.textContent = 'Age Group: ' + group;

                const isYouth = age >= 15 && age <= 30;
                const isSenior = age >= 60;
                youthEl.textContent = 'Youth: ' + (isYouth ? 'Yes' : 'No');
                seniorEl.textContent = 'Senior: ' + (isSenior ? 'Yes' : 'No');
            }

            dob.addEventListener('change', refresh);
            dob.addEventListener('input', refresh);
            refresh();
        })();
    </script>
}
