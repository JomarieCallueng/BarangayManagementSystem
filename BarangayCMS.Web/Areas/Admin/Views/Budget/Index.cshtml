@model IEnumerable<BarangayCMS.Web.Areas.Admin.Models.BudgetViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Budget Annual Planner";
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Now.Year;

    // 💡 Safe parsing mula sa String pabalik sa Decimal
    decimal totalBarangayBudget = 200000000.00m; // Default Value

    if (TempData[$"AnnualBudget_{selectedYear}"] != null &&
        decimal.TryParse(TempData[$"AnnualBudget_{selectedYear}"]?.ToString(), out decimal parsedBudget))
    {
        totalBarangayBudget = parsedBudget;
    }

    // Panatilihin ang TempData sa mga susunod na request
    TempData.Keep($"AnnualBudget_{selectedYear}");

    // Calculations
    decimal totalAllocated = Model != null ? Model.Sum(b => b.AllocatedAmount) : 0;
    decimal totalDisbursed = Model != null ? Model.Sum(b => b.UsedAmount) : 0;
    decimal unallocatedBalance = totalBarangayBudget - totalAllocated;
    var allocatedPct = totalBarangayBudget > 0 ? (totalAllocated / totalBarangayBudget) * 100 : 0;
    var disbursedPct = totalAllocated > 0 ? (totalDisbursed / totalAllocated) * 100 : 0;
}

<style>
    /* Matches the Reports page badge sizing for a consistent look. */
    .trend-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 6px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-cash-coin text-success me-2"></i>Budget Allocation Planner</h2>
        <p class="text-muted small mb-0">Monitor annual barangay fiscal funds, total allocations, disbursements, and balances.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" action="/Admin/Budget" class="d-flex align-items-center gap-1">
            <select name="year" class="form-select form-select-sm" onchange="this.form.submit()" style="width: 110px;">
                @for (int y = DateTime.Now.Year + 1; y >= DateTime.Now.Year - 5; y--)
                {
                    <!option value="@y" @(y == selectedYear ? "selected" : "")>FY @y</!option>
                }
            </select>
        </form>

        <!-- BUTTON PARA MAG-SET NG ANNUAL BUDGET -->
        <button type="button" class="btn btn-outline-primary shadow-sm fw-semibold btn-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#setBudgetModal">
            <i class="bi bi-piggy-bank me-1"></i> Set Annual Budget
        </button>

        <a href="/Admin/Budget/Create" class="btn btn-success shadow-sm fw-semibold btn-sm d-flex align-items-center">
            <i class="bi bi-plus-lg me-1"></i> Add Budget Category
        </a>
    </div>
</div>

<!-- Financial Summary Cards (Fixed Layout for Large Numbers) -->
<div class="row g-3 mb-4">
    <!-- Total Annual Budget -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100 overflow-hidden">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div style="min-width: 0;">
                    <h6 class="text-muted small text-uppercase mb-1 text-truncate">Total Annual Budget</h6>
                    <h3 class="fw-bold text-dark mb-0 text-truncate" title="₱@totalBarangayBudget.ToString("N2")" style="font-size: 1.2rem;">
                        ₱@totalBarangayBudget.ToString("N2")
                    </h3>
                </div>
                <div class="flex-shrink-0">
                    <div class="bg-light p-2 rounded text-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-bank fs-5"></i>
                    </div>
                </div>
            </div>
            <div class="mt-2">
                <span class="badge bg-secondary-subtle text-dark trend-badge"><i class="bi bi-calendar3 me-1"></i>Fiscal Year @selectedYear</span>
            </div>
        </div>
    </div>

    <!-- Total Allocated -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100 overflow-hidden">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div style="min-width: 0;">
                    <h6 class="text-muted small text-uppercase mb-1 text-truncate">Allocated to Programs</h6>
                    <h3 class="fw-bold text-dark mb-0 text-truncate" title="₱@totalAllocated.ToString("N2")" style="font-size: 1.2rem;">
                        ₱@totalAllocated.ToString("N2")
                    </h3>
                </div>
                <div class="flex-shrink-0">
                    <div class="bg-light p-2 rounded text-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-diagram-3-fill fs-5"></i>
                    </div>
                </div>
            </div>
            <div class="mt-2">
                <span class="badge bg-primary-subtle text-primary trend-badge"><i class="bi bi-pie-chart me-1"></i>@allocatedPct.ToString("N1")% ng budget</span>
            </div>
        </div>
    </div>

    <!-- Remaining / Unallocated -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100 overflow-hidden">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div style="min-width: 0;">
                    <h6 class="text-muted small text-uppercase mb-1 text-truncate">Remaining Budget</h6>
                    <h3 class="fw-bold mb-0 text-truncate @(unallocatedBalance >= 0 ? "text-dark" : "text-danger")" title="₱@unallocatedBalance.ToString("N2")" style="font-size: 1.2rem;">
                        ₱@unallocatedBalance.ToString("N2")
                    </h3>
                </div>
                <div class="flex-shrink-0">
                    <div class="bg-light p-2 rounded @(unallocatedBalance >= 0 ? "text-success" : "text-danger") d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-wallet2 fs-5"></i>
                    </div>
                </div>
            </div>
            <div class="mt-2">
                @if (unallocatedBalance >= 0)
                {
                    <span class="badge bg-success-subtle text-success trend-badge"><i class="bi bi-check-circle me-1"></i>Unallocated balance</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger trend-badge"><i class="bi bi-exclamation-triangle me-1"></i>Over-allocated</span>
                }
            </div>
        </div>
    </div>

    <!-- Total Disbursed -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100 overflow-hidden">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div style="min-width: 0;">
                    <h6 class="text-muted small text-uppercase mb-1 text-truncate">Disbursed (Spent)</h6>
                    <h3 class="fw-bold text-dark mb-0 text-truncate" title="₱@totalDisbursed.ToString("N2")" style="font-size: 1.2rem;">
                        ₱@totalDisbursed.ToString("N2")
                    </h3>
                </div>
                <div class="flex-shrink-0">
                    <div class="bg-light p-2 rounded text-danger d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-cash-stack fs-5"></i>
                    </div>
                </div>
            </div>
            <div class="mt-2">
                <span class="badge bg-danger-subtle text-danger trend-badge"><i class="bi bi-graph-down-arrow me-1"></i>@disbursedPct.ToString("N1")% ng allocated</span>
            </div>
        </div>
    </div>
</div>

<!-- Breakdown Summary Per Fund Source -->
@if (Model != null && Model.Any())
{
    <div class="d-flex align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Allocation Summary Per Fund Source</h5>
        <span class="badge bg-light text-dark small ms-2">Fiscal Year @selectedYear</span>
    </div>
    <div class="row g-3 mb-4">
        @foreach (var group in Model.GroupBy(b => string.IsNullOrEmpty(b.MainFundSource) ? "General Fund" : b.MainFundSource))
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted small text-uppercase mb-1"><i class="bi bi-wallet2 me-1"></i>@group.Key</h6>
                            <h4 class="fw-bold text-dark mb-0">₱@group.Sum(x => x.AllocatedAmount).ToString("N2")</h4>
                        </div>
                        <span class="badge bg-info-subtle text-info trend-badge">@group.Count() program(s)</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Main Budget Table -->
<div class="d-flex align-items-center mb-3">
    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-table text-success me-2"></i>Budget Categories &amp; Programs</h5>
    <span class="badge bg-light text-dark small ms-2">@(Model?.Count() ?? 0) record(s)</span>
</div>
<div class="card border-0 shadow-sm rounded p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Fiscal Year</th>
                    <th>Fund Category & Program</th>
                    <th>Pinagmulan (Fund Source)</th>
                    <th class="text-end">Total Allocation</th>
                    <th class="text-end">Disbursed (Used)</th>
                    <th class="text-end">Available Balance</th>
                    <th class="text-center text-nowrap actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var remainingBalance = item.AllocatedAmount - item.UsedAmount;
                        <tr>
                            <td class="fw-bold text-secondary">FY @item.FiscalYear</td>
                            <td>
                                <span class="fw-bold text-dark d-block">@item.Category</span>
                                <small class="text-muted d-block text-truncate" style="max-width: 250px;">@item.Remarks</small>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info-emphasis border border-info px-2 py-1">
                                    <i class="bi bi-wallet2 me-1"></i>@(string.IsNullOrEmpty(item.MainFundSource) ? "General Fund" : item.MainFundSource)
                                </span>
                            </td>
                            <td class="text-end fw-semibold text-primary">₱@item.AllocatedAmount.ToString("N2")</td>
                            <td class="text-end fw-semibold text-danger">₱@item.UsedAmount.ToString("N2")</td>
                            <td class="text-end fw-bold @(remainingBalance >= 0 ? "text-success" : "text-danger")">
                                ₱@remainingBalance.ToString("N2")
                            </td>
                            <td class="text-center text-nowrap actions-col">
                                <div class="btn-group btn-group-sm flex-nowrap" role="group">
                                    <a href="/Admin/Budget/Income/@item.Id" class="btn btn-outline-success" title="Add Funds / Income"><i class="bi bi-plus-circle"></i></a>
                                    <a href="/Admin/Budget/Expenses/@item.Id" class="btn btn-outline-warning text-dark" title="Disburse / Expense"><i class="bi bi-dash-circle"></i></a>
                                    <a href="/Admin/Budget/Edit/@item.Id" class="btn btn-outline-primary" title="Edit Category"><i class="bi bi-pencil"></i></a>
                                    <a href="/Admin/Budget/Delete/@item.Id" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-wallet2 display-6 d-block mb-2"></i>
                            <span>No budget distributions configured for the year @selectedYear.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL DIALOG PARA SA SET ANNUAL BUDGET -->
<div class="modal fade" id="setBudgetModal" tabindex="-1" aria-labelledby="setBudgetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/Admin/Budget/SetAnnualBudget" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@selectedYear" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-dark" id="setBudgetModalLabel">
                        <i class="bi bi-piggy-bank text-primary me-2"></i>Set Total Annual Budget (FY @selectedYear)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kabuuang Pondo ng Barangay (Pesos)</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input type="number" step="0.01" min="0" name="annualBudget" class="form-control form-control-lg fw-bold text-primary" value="@totalBarangayBudget" required />
                        </div>
                        <small class="text-muted mt-1 d-block">
                            Ito ang magiging batayan ng kabuuang pera kung saan mababawas ang bawat program category.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">Save Annual Budget</button>
                </div>
            </form>
        </div>
    </div>
</div>