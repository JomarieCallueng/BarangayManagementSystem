@model BarangayCMS.Web.Areas.Admin.Models.BudgetViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Bagong Alokasyon ng Pondo";
}

<div class="container mt-4" style="max-width: 750px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white py-3" style="background-color: #198754 !important;">
            <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Bagong Alokasyon ng Pondo</h4>
        </div>
        <div class="card-body p-4">

            <form asp-area="Admin" asp-controller="Budget" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row mb-3">
                    <!-- 🔑 PINAGMULAN NG PONDO (MOTHER FUND) -->
                    <div class="col-md-6">
                        <label asp-for="MainFundSource" class="form-label fw-bold">Pinagmulan ng Pondo (Main Source)</label>
                        <select asp-for="MainFundSource" class="form-select">
                            <option value="">-- Pumili ng Pinagmulan --</option>
                            <option value="Educational Fund">Educational Fund</option>
                            <option value="General Fund (NTA / IRA)">General Fund (NTA / IRA)</option>
                            <option value="Gender and Development (GAD) Fund">Gender & Development (GAD) Fund</option>
                            <option value="Disaster Risk Reduction (LDRRMF)">Disaster Risk Reduction (LDRRMF)</option>
                            <option value="Sangguniang Kabataan (SK) Fund">Sangguniang Kabataan (SK) Fund</option>
                            <option value="Senior Citizens & PWD Fund">Senior Citizens & PWD Fund</option>
                        </select>
                        <span asp-validation-for="MainFundSource" class="text-danger small"></span>
                    </div>

                    <!-- GAGAMITAN NG PONDO / SUB-CATEGORY -->
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label fw-bold">Gagamitan ng Pondo (Program/Project)</label>
                        <input asp-for="Category" class="form-control" placeholder="Halimbawa: Educational Allowance" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <!-- Inilaang Pondo -->
                    <div class="col-md-6">
                        <label asp-for="AllocatedAmount" class="form-label fw-bold">Inilaang Pondo</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="AllocatedAmount" class="form-control" type="number" step="0.01" placeholder="1000000.00" />
                        </div>
                        <span asp-validation-for="AllocatedAmount" class="text-danger small"></span>
                    </div>

                    <!-- Taon ng Pananalapi -->
                    <div class="col-md-6">
                        <label asp-for="FiscalYear" class="form-label fw-bold">Taon ng Pananalapi</label>
                        <input asp-for="FiscalYear" class="form-control" type="number" />
                        <span asp-validation-for="FiscalYear" class="text-danger small"></span>
                    </div>
                </div>

                <input type="hidden" asp-for="UsedAmount" value="0" />

                <!-- Remarks -->
                <div class="mb-4">
                    <label asp-for="Remarks" class="form-label fw-bold">Mga Karagdagang Detalye / Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="4" placeholder="Halimbawa: Alokasyon para sa 500 na benepisyaryo ng allowance..."></textarea>
                    <span asp-validation-for="Remarks" class="text-danger small"></span>
                </div>

                <hr />

                <div class="d-flex justify-content-between mt-3">
                    <a asp-area="Admin" asp-controller="Budget" asp-action="Index" class="btn btn-secondary px-4">Bumalik</a>
                    <button type="submit" class="btn btn-success px-4 fw-bold">I-save Alokasyon</button>
                </div>
            </form>

        </div>
    </div>
</div>