@model BarangayCMS.Web.Areas.Admin.Models.ProjectExpenseViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Record Project Expense";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-receipt"></i> Record Project Expense</h1>
    </div>
    <a href="@(Model.ReturnProjectId.HasValue ? $"/Admin/Budget?projectId={Model.ReturnProjectId}" : "/Admin/Budget")" class="btn btn-light border fw-semibold rounded-3">
        <i class="bi bi-arrow-left me-1"></i> Bumalik
    </a>
</div>

<div class="form-page">
    <form asp-area="Admin" asp-controller="Budget" asp-action="AddExpense" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnProjectId" />
        <div class="app-card app-card--pad">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ProjectId" class="form-label fw-bold">Proyekto</label>
                <select asp-for="ProjectId" class="form-select">
                    <option value="">-- Pumili ng Proyekto --</option>
                    @foreach (var p in Model.ProjectOptions)
                    {
                        <option value="@p.Id" selected="@(Model.ProjectId == p.Id)">@p.DisplayLabel</option>
                    }
                </select>
                <span asp-validation-for="ProjectId" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Category" class="form-label fw-bold">Kategorya</label>
                    <select asp-for="Category" class="form-select">
                        @foreach (var c in BarangayCMS.Web.Areas.Admin.Models.ProjectExpenseViewModel.Categories)
                        {
                            <option value="@c" selected="@(Model.Category == c)">@c</option>
                        }
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Amount" class="form-label fw-bold">Halaga (₱)</label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ExpenseDate" class="form-label fw-bold">Petsa ng Gastos</label>
                <input asp-for="ExpenseDate" class="form-control" type="date" />
                <span asp-validation-for="ExpenseDate" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Deskripsyon</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detalye ng gastos..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                <a href="@(Model.ReturnProjectId.HasValue ? $"/Admin/Budget?projectId={Model.ReturnProjectId}" : "/Admin/Budget")" class="btn btn-light border px-4">Kanselahin</a>
                <button type="submit" class="btn btn-success px-4 fw-semibold"><i class="bi bi-save me-1"></i>I-save ang Gastos</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
