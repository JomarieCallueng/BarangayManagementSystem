@model BarangayCMS.Web.Areas.Admin.Models.OfficialHistoryViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Service History";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-clock-history"></i> Service History</h1>
        <p class="page-header__sub mb-0">Mga termino ni <strong>@Model.OfficialName</strong> — kasalukuyan: @Model.CurrentPosition</p>
    </div>
    <a href="/Admin/BarangayOfficials" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Bumalik sa Officials</a>
</div>

<div class="row g-4">
    <!-- Existing terms -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded">
            <div class="card-header bg-white fw-bold"><i class="bi bi-list-ul me-1"></i> Mga Naitalang Termino</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Taon</th>
                            <th>Posisyon</th>
                            <th>Komite</th>
                            <th>Status</th>
                            <th class="text-center">Aksyon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Terms.Any())
                        {
                            @foreach (var t in Model.Terms)
                            {
                                var range = t.StartDate.Year + " – " + (t.EndDate.HasValue ? t.EndDate.Value.Year.ToString() : "Present");
                                <tr>
                                    <td class="fw-semibold text-nowrap">@range</td>
                                    <td>@t.Position</td>
                                    <td class="text-muted small">@(string.IsNullOrEmpty(t.Committee) ? "—" : t.Committee)</td>
                                    <td>
                                        @if (t.EndDate == null || t.Status == "Current")
                                        {
                                            <span class="badge bg-success">Current</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Completed</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="official-actions">
                                            <button type="button" class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit this term"
                                                    data-bs-toggle="modal" data-bs-target="#editHistoryModal-@t.Id">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                            </button>
                                            <form method="post" action="/Admin/BarangayOfficials/DeleteHistory" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this service history record?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="historyId" value="@t.Id" />
                                                <input type="hidden" name="officialId" value="@Model.OfficialId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete this term"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">Wala pang naitalang termino.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add new term -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded">
            <div class="card-header bg-white fw-bold"><i class="bi bi-plus-circle me-1"></i> Magdagdag ng Termino</div>
            <div class="card-body">
                <form method="post" action="/Admin/BarangayOfficials/AddHistory">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OfficialId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="NewPosition" class="form-label fw-semibold small"></label>
                        <input asp-for="NewPosition" class="form-control" placeholder="e.g., Barangay Councilor" />
                        <span asp-validation-for="NewPosition" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCommittee" class="form-label fw-semibold small"></label>
                        <input asp-for="NewCommittee" class="form-control" placeholder="e.g., Peace & Order Committee" />
                        <span asp-validation-for="NewCommittee" class="text-danger small"></span>
                    </div>
                    <div class="row g-2">
                        <div class="col-6 mb-3">
                            <label asp-for="NewStartYear" class="form-label fw-semibold small"></label>
                            <input asp-for="NewStartYear" type="number" min="1900" max="2200" class="form-control" placeholder="2019" />
                            <span asp-validation-for="NewStartYear" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="NewEndYear" class="form-label fw-semibold small"></label>
                            <input asp-for="NewEndYear" type="number" min="1900" max="2200" class="form-control" placeholder="Blank = Present" />
                            <span asp-validation-for="NewEndYear" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="form-text mb-3">Iwanang blanko ang End Year kung ito ang kasalukuyang termino (Present).</div>
                    <button type="submit" class="btn btn-brand w-100"><i class="bi bi-save me-1"></i> Idagdag sa History</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* ----- EDIT MODALS (isa bawat termino; ina-update ang parehong record) ----- *@
@foreach (var t in Model.Terms)
{
    <div class="modal fade" id="editHistoryModal-@t.Id" tabindex="-1" aria-labelledby="editHistoryLabel-@t.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form method="post" action="/Admin/BarangayOfficials/EditHistory" class="history-edit-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="historyId" value="@t.Id" />
                    <input type="hidden" name="officialId" value="@Model.OfficialId" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="editHistoryLabel-@t.Id"><i class="bi bi-pencil-square me-2 text-primary"></i>I-edit ang Termino</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Posisyon</label>
                            <input name="editPosition" class="form-control" value="@t.Position" maxlength="100" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Komite (Committee)</label>
                            <input name="editCommittee" class="form-control" value="@t.Committee" maxlength="100" placeholder="Opsyonal" />
                        </div>
                        <div class="row g-2">
                            <div class="col-6 mb-1">
                                <label class="form-label fw-semibold small">Start Year</label>
                                <input name="editStartYear" type="number" min="1900" max="2200" class="form-control" value="@t.StartDate.Year" required />
                            </div>
                            <div class="col-6 mb-1">
                                <label class="form-label fw-semibold small">End Year</label>
                                <input name="editEndYear" type="number" min="1900" max="2200" class="form-control" value="@(t.EndDate?.Year)" placeholder="Blank = Present" />
                            </div>
                        </div>
                        <div class="form-text">Iwanang blanko ang End Year kung ito ang kasalukuyang termino (Present).</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Kanselahin</button>
                        <button type="submit" class="btn btn-brand"><i class="bi bi-save me-1"></i>I-save ang Pagbabago</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Client-side guard (backend ang panghuling awtoridad): Start Year <= End Year.
        document.querySelectorAll('.history-edit-form').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                var s = parseInt(f.querySelector('[name="editStartYear"]').value, 10);
                var eRaw = f.querySelector('[name="editEndYear"]').value;
                if (eRaw !== '' && !isNaN(s) && parseInt(eRaw, 10) < s) {
                    e.preventDefault();
                    alert('Ang End Year ay hindi pwedeng mas maaga sa Start Year.');
                }
            });
        });
    </script>
}
