@model IEnumerable<BarangayCMS.Web.Areas.Admin.Models.BarangayOfficialViewModel>
@using BarangayCMS.Web.Areas.Admin.Services

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Barangay Officials";
    var summary = ViewBag.Summary as StructureSummary;

    var all = (Model ?? Enumerable.Empty<BarangayCMS.Web.Areas.Admin.Models.BarangayOfficialViewModel>()).ToList();

    bool IsSk(string? p) => OfficialStructure.IsSk(p);
    bool IsSkChair(BarangayCMS.Web.Areas.Admin.Models.BarangayOfficialViewModel o)
        => OfficialStructure.Classify(o.Position) == OfficialSlot.SkChair;

    // SANGGUNIANG BARANGAY = mga hindi SK + SK Chairperson (Ex-Officio, iisang record).
    var sbRows = all.Where(o => !IsSk(o.Position) || IsSkChair(o)).ToList();
    // SANGGUNIANG KABATAAN = lahat ng SK.
    var skRows = all.Where(o => IsSk(o.Position)).ToList();
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-person-badge"></i> Barangay Officials Council</h1>
        <p class="page-header__sub mb-0">Active roster of the barangay governance council — Sangguniang Barangay at Sangguniang Kabataan.</p>
    </div>
    <a href="/Admin/BarangayOfficials/Create" class="btn btn-brand fw-semibold rounded-3">
        <i class="bi bi-person-plus-fill me-1"></i> Add Council Member
    </a>
</div>

@if (summary != null)
{
    @await Html.PartialAsync("_StructureSummary", summary)
}

<!-- 🔧 TOOLBAR: council tabs + search + status filter -->
<div class="officials-toolbar app-card app-card--pad mb-3">
    <div class="officials-tabs" role="tablist" aria-label="Council selector">
        <button type="button" class="officials-tab is-active" role="tab" aria-selected="true"
                data-council="sb" id="tab-sb" aria-controls="panel-sb">
            <i class="bi bi-building me-1"></i> Sangguniang Barangay
            <span class="officials-tab__count">@sbRows.Count</span>
        </button>
        <button type="button" class="officials-tab" role="tab" aria-selected="false"
                data-council="sk" id="tab-sk" aria-controls="panel-sk">
            <i class="bi bi-people me-1"></i> Sangguniang Kabataan
            <span class="officials-tab__count">@skRows.Count</span>
        </button>
    </div>

    <div class="officials-filters">
        <div class="officials-search input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="officialSearch" class="form-control border-start-0"
                   placeholder="Search by name, position, or committee…" autocomplete="off"
                   aria-label="Search officials" />
            <button type="button" id="clearSearch" class="btn btn-outline-secondary border-start-0 d-none"
                    title="Clear search" aria-label="Clear search"><i class="bi bi-x-lg"></i></button>
        </div>
        <select id="statusFilter" class="form-select officials-status" aria-label="Filter by status">
            <option value="all">All statuses</option>
            <option value="active">Active only</option>
            <option value="inactive">Term ended</option>
        </select>
    </div>
</div>

@{
    var vd = new ViewDataDictionary(ViewData);
}

@* ---- SANGGUNIANG BARANGAY ---- *@
<div class="card border-0 shadow-sm rounded p-4 mb-4 council-panel" id="panel-sb" role="tabpanel" aria-labelledby="tab-sb" data-council="sb">
    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-building text-primary me-2"></i>Sangguniang Barangay</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Official Name</th>
                    <th>Position</th>
                    <th>Committee Assignment</th>
                    <th>Status</th>
                    <th class="text-center actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in sbRows)
                {
                    var rowData = new ViewDataDictionary(ViewData);
                    if (IsSkChair(item)) { rowData["PositionLabel"] = "SK Chairperson — Ex-Officio Member"; }
                    @await Html.PartialAsync("_OfficialRow", item, rowData)
                }
                <tr class="empty-row"><td colspan="5" class="text-center py-4 text-muted">@(sbRows.Any() ? "" : "No Sangguniang Barangay officials yet.")</td></tr>
                <tr class="no-results-row d-none"><td colspan="5" class="text-center py-4 text-muted"><i class="bi bi-search me-1"></i>No officials match your search.</td></tr>
            </tbody>
        </table>
    </div>
</div>

@* ---- SANGGUNIANG KABATAAN ---- *@
<div class="card border-0 shadow-sm rounded p-4 mb-4 council-panel d-none" id="panel-sk" role="tabpanel" aria-labelledby="tab-sk" data-council="sk">
    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-people text-primary me-2"></i>Sangguniang Kabataan</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Official Name</th>
                    <th>Position</th>
                    <th>Committee Assignment</th>
                    <th>Status</th>
                    <th class="text-center actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in skRows)
                {
                    @await Html.PartialAsync("_OfficialRow", item)
                }
                <tr class="empty-row"><td colspan="5" class="text-center py-4 text-muted">@(skRows.Any() ? "" : "No Sangguniang Kabataan officials yet.")</td></tr>
                <tr class="no-results-row d-none"><td colspan="5" class="text-center py-4 text-muted"><i class="bi bi-search me-1"></i>No officials match your search.</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var search = document.getElementById('officialSearch');
            var clearBtn = document.getElementById('clearSearch');
            var statusSel = document.getElementById('statusFilter');
            var tabs = Array.prototype.slice.call(document.querySelectorAll('.officials-tab'));
            var panels = Array.prototype.slice.call(document.querySelectorAll('.council-panel'));

            // --- Tab switching (client-side, no reload) ---
            function activateTab(council) {
                tabs.forEach(function (t) {
                    var on = t.getAttribute('data-council') === council;
                    t.classList.toggle('is-active', on);
                    t.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                panels.forEach(function (p) {
                    p.classList.toggle('d-none', p.getAttribute('data-council') !== council);
                });
                applyFilters();
            }
            tabs.forEach(function (t) {
                t.addEventListener('click', function () { activateTab(t.getAttribute('data-council')); });
            });

            // --- Search + status filtering within the visible panel ---
            function applyFilters() {
                var q = (search.value || '').trim().toLowerCase();
                var status = statusSel.value;
                clearBtn.classList.toggle('d-none', q.length === 0);

                panels.forEach(function (panel) {
                    if (panel.classList.contains('d-none')) return; // only the active panel
                    var rows = Array.prototype.slice.call(panel.querySelectorAll('tr.official-row'));
                    var visible = 0;
                    rows.forEach(function (r) {
                        var matchText = !q || (r.getAttribute('data-search') || '').indexOf(q) !== -1;
                        var matchStatus = status === 'all' || (r.getAttribute('data-status') === status);
                        var show = matchText && matchStatus;
                        r.classList.toggle('d-none', !show);
                        if (show) visible++;
                    });
                    var filtering = q.length > 0 || status !== 'all';
                    var hasRows = rows.length > 0;
                    // empty-row: only when the panel genuinely has no officials and no filter applied
                    var emptyRow = panel.querySelector('tr.empty-row');
                    var noResultsRow = panel.querySelector('tr.no-results-row');
                    if (emptyRow) emptyRow.classList.toggle('d-none', hasRows || filtering);
                    if (noResultsRow) noResultsRow.classList.toggle('d-none', !(hasRows && filtering && visible === 0));
                });
            }

            search.addEventListener('input', applyFilters);
            statusSel.addEventListener('change', applyFilters);
            clearBtn.addEventListener('click', function () {
                search.value = '';
                search.focus();
                applyFilters();
            });

            applyFilters();
        })();
    </script>
}
