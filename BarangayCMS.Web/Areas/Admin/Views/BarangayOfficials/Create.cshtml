@model BarangayCMS.Web.Areas.Admin.Models.BarangayOfficialViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BarangayCMS.Web.Areas.Admin.Services

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Magdagdag ng Opisyal";
    var counts = ViewBag.SlotCounts as Dictionary<OfficialSlot, int> ?? new Dictionary<OfficialSlot, int>();
    var summary = ViewBag.Summary as StructureSummary;
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-person-plus-fill"></i> Magrehistro ng Bagong Opisyal</h1>
    </div>
    <a asp-action="Index" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
</div>

<div class="form-page">
    @if (summary != null)
    {
        @await Html.PartialAsync("_StructureSummary", summary)
    }
    <form asp-action="Create" enctype="multipart/form-data">
        <div class="app-card app-card--pad">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-bold"></label>
                <input asp-for="FullName" class="form-control" placeholder="Juan D. Dela Cruz" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Position" class="form-label fw-bold"></label>
                <select asp-for="Position" class="form-select">
                    <option value="">-- Pumili ng Posisyon --</option>
                    @foreach (var opt in OfficialStructure.Options)
                    {
                        var used = counts.TryGetValue(opt.Slot, out var c) ? c : 0;
                        var limit = OfficialStructure.Limit(opt.Slot);
                        var full = limit != int.MaxValue && used >= limit;
                        var suffix = limit == int.MaxValue ? "" : $" ({used}/{limit})" + (full ? " — Puno na" : "");
                        <option value="@opt.Value" disabled="@full">@opt.Label@suffix</option>
                    }
                </select>
                <span asp-validation-for="Position" class="text-danger"></span>
                <div class="form-text">Ang mga posisyong <strong>puno na</strong> ay naka-disable. I-deactivate muna ang kasalukuyang nakaupo bago magdagdag ng bago.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Committee" class="form-label fw-bold"></label>
                <select asp-for="Committee" id="committeeField" class="form-select" data-current="@Model.Committee">
                    <option value="">-- Walang tiyak na komite --</option>
                </select>
                <span asp-validation-for="Committee" class="text-danger"></span>
                <div id="committeeNote" class="form-text"></div>
            </div>

            <div class="mb-3">
                <label asp-for="ProfileImageFile" class="form-label fw-bold"></label>
                <input asp-for="ProfileImageFile" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" />
                <div class="form-text">Larawan ng opisyal na ipapakita sa public "About the Barangay" page. (Optional — kung wala, initials ang ipapakita.)</div>
            </div>

            <div class="mb-3 form-check form-switch pt-2">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="flexSwitchCheckChecked" checked>
                <label class="form-check-label fw-bold" for="flexSwitchCheckChecked">Kasalukuyang Aktibo sa Serbisyo</label>
            </div>

            <div class="d-flex gap-2 justify-content-end border-top pt-3 mt-4">
                <a asp-action="Index" class="btn btn-light border px-4">Bumalik</a>
                <button type="submit" class="btn btn-brand px-4">I-save ang Opisyal</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_CommitteeAssignmentScript" />
}
