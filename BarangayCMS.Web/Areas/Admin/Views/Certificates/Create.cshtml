@model BarangayCMS.Web.Areas.Admin.Models.CertificateViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "New Request";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-file-earmark-text"></i> Certificate Document Request</h1>
    </div>
    <a asp-area="Admin" asp-controller="Certificates" asp-action="Index" class="btn btn-light border fw-semibold rounded-3">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="form-page">
    <form asp-area="Admin" asp-controller="Certificates" asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        
        <div class="app-card app-card--pad">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

            <!-- Resident Dropdown -->
            <div class="mb-3">
                <label asp-for="ResidentId" class="form-label">Resident</label>
                <select asp-for="ResidentId" class="form-select" asp-items="Model.ResidentList">
                    <option value="">-- Select Resident --</option>
                </select>
                <span asp-validation-for="ResidentId" class="text-danger"></span>
            </div>

            <!-- Certificate Type Dropdown -->
            <div class="mb-3">
                <label asp-for="CertificateType" class="form-label">Certificate Type</label>
                <select asp-for="CertificateType" class="form-select">
                    <option value="">-- Choose Type --</option>
                    <option value="Barangay Clearance">Barangay Clearance</option>
                    <option value="Certificate of Indigency">Certificate of Indigency</option>
                    <option value="Certificate of Residency">Certificate of Residency</option>
                </select>
                <span asp-validation-for="CertificateType" class="text-danger"></span>
            </div>

            <!-- Purpose / Dahilan ng Pagkuha (ITO ANG KULANG) -->
            <div class="mb-3">
                <label asp-for="Purpose" class="form-label">Purpose / Dahilan ng Pagkuha</label>
                <input asp-for="Purpose" class="form-control" placeholder="Halimbawa: Local Employment, Scholarship, ID Requirement" />
                <span asp-validation-for="Purpose" class="text-danger"></span>
            </div>

            <!-- Dates and Status -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DateRequested" class="form-label">Date Requested</label>
                    <input asp-for="DateRequested" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="DateRequested" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Issued">Issued</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <!-- Optional Date Issued -->
            <div class="mb-3">
                <label asp-for="DateIssued" class="form-label">Date Issued (Optional if Pending)</label>
                <input asp-for="DateIssued" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="DateIssued" class="text-danger"></span>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2 justify-content-end border-top pt-3 mt-4">
                <a asp-area="Admin" asp-controller="Certificates" asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                <button type="submit" class="btn btn-success px-4">Save Request</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}