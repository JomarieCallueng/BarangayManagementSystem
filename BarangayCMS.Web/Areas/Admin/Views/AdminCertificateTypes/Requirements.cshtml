@model IEnumerable<BarangayCMS.DTO.CertificateRequirementDTO>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var certType = ViewBag.CertificateType as BarangayCMS.Entities.CertificateType;
    ViewData["Title"] = "Manage Requirements";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-clipboard-check text-primary me-2"></i>Certificate Requirements</h2>
        <p class="text-muted small mb-0">
            Certificate: <span class="fw-semibold text-dark">@certType?.CertificateName</span> &mdash;
            requirements you configure here appear automatically on the Staff and Resident request forms.
        </p>
    </div>
    <a href="/Admin/AdminCertificateTypes" class="btn btn-outline-secondary fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Back to Certificate Types
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Existing requirements -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded p-4">
            <h5 class="fw-bold text-dark mb-3">Configured Requirements</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px;">Order</th>
                            <th>Requirement</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var r in Model)
                            {
                                <tr>
                                    <td class="text-muted">@r.DisplayOrder</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@r.RequirementName</div>
                                        @if (!string.IsNullOrWhiteSpace(r.Description))
                                        {
                                            <div class="text-muted small">@r.Description</div>
                                        }
                                    </td>
                                    <td>
                                        @if (r.IsRequired)
                                        {
                                            <span class="badge bg-primary-subtle text-primary fw-semibold">Required</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary fw-semibold">Optional</span>
                                        }
                                    </td>
                                    <td>
                                        @if (r.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success fw-semibold">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted fw-semibold">Hidden</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-req"
                                                data-id="@r.Id"
                                                data-name="@r.RequirementName"
                                                data-description="@r.Description"
                                                data-required="@r.IsRequired.ToString().ToLower()"
                                                data-active="@r.IsActive.ToString().ToLower()"
                                                data-order="@r.DisplayOrder"
                                                data-bs-toggle="modal" data-bs-target="#editReqModal">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <form asp-area="Admin" asp-controller="AdminCertificateTypes" asp-action="DeleteRequirement"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Remove this requirement?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <input type="hidden" name="certificateTypeId" value="@certType?.CertificateTypeId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-clipboard-x display-6 d-block mb-2"></i>
                                    <span>No requirements configured yet. Add one using the form on the right.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add requirement -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-plus-circle me-1 text-primary"></i>Add Requirement</h5>
            <form asp-area="Admin" asp-controller="AdminCertificateTypes" asp-action="AddRequirement" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CertificateTypeId" value="@certType?.CertificateTypeId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Requirement Name <span class="text-danger">*</span></label>
                    <input type="text" name="RequirementName" class="form-control" placeholder="e.g. Valid Government ID" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea name="Description" class="form-control" rows="2" placeholder="Optional details for the applicant"></textarea>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control" value="@((Model?.Count() ?? 0) + 1)" min="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Type</label>
                        <select name="IsRequired" class="form-select">
                            <option value="true" selected>Required</option>
                            <option value="false">Optional</option>
                        </select>
                    </div>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="addActive" checked />
                    <label class="form-check-label" for="addActive">Active (visible on request forms)</label>
                </div>
                <button type="submit" class="btn btn-brand w-100"><i class="bi bi-check-circle me-1"></i>Add Requirement</button>
            </form>
        </div>
    </div>
</div>

<!-- Edit Requirement Modal -->
<div class="modal fade" id="editReqModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-area="Admin" asp-controller="AdminCertificateTypes" asp-action="EditRequirement" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editReqId" />
                <input type="hidden" name="CertificateTypeId" value="@certType?.CertificateTypeId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit Requirement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Requirement Name <span class="text-danger">*</span></label>
                        <input type="text" name="RequirementName" id="editReqName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" id="editReqDescription" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Display Order</label>
                            <input type="number" name="DisplayOrder" id="editReqOrder" class="form-control" min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Type</label>
                            <select name="IsRequired" id="editReqRequired" class="form-select">
                                <option value="true">Required</option>
                                <option value="false">Optional</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editReqActive" />
                        <label class="form-check-label" for="editReqActive">Active (visible on request forms)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-brand">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".btn-edit-req").forEach(function (btn) {
            btn.addEventListener("click", function () {
                document.getElementById("editReqId").value = btn.dataset.id;
                document.getElementById("editReqName").value = btn.dataset.name || "";
                document.getElementById("editReqDescription").value = btn.dataset.description || "";
                document.getElementById("editReqOrder").value = btn.dataset.order || 0;
                document.getElementById("editReqRequired").value = btn.dataset.required === "true" ? "true" : "false";
                document.getElementById("editReqActive").checked = btn.dataset.active === "true";
            });
        });
    </script>
}
