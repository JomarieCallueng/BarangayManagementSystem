@model BarangayCMS.Web.Areas.Admin.Models.ProjectViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Burahin ang Proyekto";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Kumpirmahin ang Pagbura</h4>
        </div>
        <div class="card-body p-4 text-center">
            @{
                int finCount = ViewBag.FinancialRecordCount ?? 0;
            }
            <p class="fs-5 text-dark">Sigurado ka ba na gusto mong burahin ang proyektong ito?</p>
            <h3 class="text-danger fw-bold my-3">@Model.ProjectName</h3>

            @if (finCount > 0)
            {
                <div class="alert alert-warning text-start border-0">
                    <i class="bi bi-shield-lock-fill me-2"></i>
                    This project has <strong>@finCount financial record(s)</strong> and cannot be deleted.
                    Void its expenses first, or keep the project for record-keeping.
                </div>
                <a asp-area="Admin" asp-controller="Projects" asp-action="Index" class="btn btn-secondary px-4">Bumalik</a>
                <a href="/Admin/Budget?projectId=@Model.Id" class="btn btn-outline-success px-4"><i class="bi bi-cash-coin me-1"></i>View Financial Records</a>
            }
            else
            {
                <p class="text-muted small">Ang aksyong ito ay permanenteng hindi na mababawi.</p>
                <hr class="my-4" />

                <form asp-area="Admin" asp-controller="Projects" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-area="Admin" asp-controller="Projects" asp-action="Index" class="btn btn-secondary px-4">Hindi, Bumalik</a>
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">Oo, Burahin Ito</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>