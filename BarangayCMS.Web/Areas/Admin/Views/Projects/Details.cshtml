@model BarangayCMS.Web.Areas.Admin.Models.ProjectDetailsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Impormasyon ng Proyekto";
    var fin = Model.Financial;
}

<style>
    .fin-card { transition: transform .2s ease, box-shadow .2s ease; }
    .fin-card:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important; }
    .progress-thick { height: 14px; border-radius: 8px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-info-circle text-info me-2"></i>@Model.ProjectName</h2>
        <span class="badge bg-secondary-subtle text-dark">@Model.Status</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Projects" asp-action="Index" class="btn btn-light border fw-semibold"><i class="bi bi-arrow-left me-1"></i>Bumalik</a>
        <a asp-area="Admin" asp-controller="Projects" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark fw-semibold"><i class="bi bi-pencil-square me-1"></i>I-modify</a>
    </div>
</div>

<div class="row g-4">
    <!-- Project info -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100 fin-card">
            <div class="card-header bg-white border-0 pt-3"><h5 class="fw-bold mb-0"><i class="bi bi-clipboard-data text-primary me-2"></i>Project Details</h5></div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <p class="mb-1 text-muted small fw-bold text-uppercase">Approved Budget</p>
                        <h4 class="text-primary fw-bold mb-0">₱@Model.Budget.ToString("N2")</h4>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small fw-bold text-uppercase">Status</p>
                        <span class="badge bg-dark px-3 py-2 fs-6">@Model.Status</span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <p class="mb-1 text-muted small fw-bold text-uppercase">Araw ng Simula</p>
                        <p class="fw-semibold text-secondary mb-0">@Model.StartDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small fw-bold text-uppercase">Inaasahang Tapos</p>
                        <p class="fw-semibold text-secondary mb-0">@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("MMMM dd, yyyy") : "N/A")</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Location) || !string.IsNullOrWhiteSpace(Model.Contractor))
                {
                    <div class="row mb-3">
                        @if (!string.IsNullOrWhiteSpace(Model.Location))
                        {
                            <div class="col-md-6 mb-3 mb-md-0">
                                <p class="mb-1 text-muted small fw-bold text-uppercase">Lokasyon</p>
                                <p class="fw-semibold text-secondary mb-0">@Model.Location</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Contractor))
                        {
                            <div class="col-md-6">
                                <p class="mb-1 text-muted small fw-bold text-uppercase">Contractor</p>
                                <p class="fw-semibold text-secondary mb-0">@Model.Contractor</p>
                            </div>
                        }
                    </div>
                }
                <div>
                    <p class="mb-2 text-muted small fw-bold text-uppercase">Deskripsyon / Sakop</p>
                    <div class="p-3 bg-light rounded border" style="min-height: 90px;">
                        <p class="mb-0 text-dark">@Model.Description</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Project budget summary -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 h-100 fin-card">
            <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-cash-coin text-success me-2"></i>Project Budget</h5>
                <span class="badge bg-@fin.BudgetStatusColor-subtle text-@fin.BudgetStatusColor border border-@fin.BudgetStatusColor">@fin.BudgetStatusLabel</span>
            </div>
            <div class="card-body p-4">
                @if (!fin.HasBudget)
                {
                    <div class="alert alert-warning border-0 mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>No approved budget set for this project yet.
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <div class="h2 fw-bold text-primary mb-0">₱@fin.ApprovedBudget.ToString("N2")</div>
                        <div class="text-muted small text-uppercase">Approved Budget</div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>@fin.RawPercentUsed.ToString("0.#")% Used</span>
                        <span>₱@fin.Remaining.ToString("N2") left</span>
                    </div>
                    <div class="progress progress-thick mb-3">
                        <div class="progress-bar @fin.ProgressBarColor" role="progressbar"
                             style="width: @fin.PercentUsed.ToString(System.Globalization.CultureInfo.InvariantCulture)%;"
                             aria-valuenow="@fin.PercentUsed" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="row g-2 text-center">
                        <div class="col-6">
                            <div class="p-2 bg-light rounded">
                                <div class="fw-bold text-danger">₱@fin.TotalExpenses.ToString("N2")</div>
                                <div class="text-muted small">Total Expenses</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 bg-light rounded">
                                <div class="fw-bold @(fin.Remaining >= 0 ? "text-success" : "text-danger")">₱@fin.Remaining.ToString("N2")</div>
                                <div class="text-muted small">Remaining</div>
                            </div>
                        </div>
                    </div>
                }
                <div class="d-grid mt-3">
                    <a href="/Admin/Budget?projectId=@Model.Id" class="btn btn-outline-success fw-semibold"><i class="bi bi-cash-coin me-1"></i>View Budget Details</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent expenses -->
<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0"><i class="bi bi-receipt text-success me-2"></i>Recent Expenses</h5>
        <div class="d-flex gap-2">
            <a href="/Admin/Budget/AddExpense?projectId=@Model.Id" class="btn btn-sm btn-success"><i class="bi bi-plus-lg me-1"></i>Record Expense</a>
            @if (fin.Expenses.Any())
            {
                <a href="/Admin/Budget?projectId=@Model.Id" class="btn btn-sm btn-outline-secondary">View All Expenses</a>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th class="text-end pe-4">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (fin.Expenses.Any())
                    {
                        @foreach (var e in fin.Expenses.Take(5))
                        {
                            <tr>
                                <td class="ps-4 text-nowrap"><small class="text-muted">@e.ExpenseDate.ToString("MM/dd/yyyy")</small></td>
                                <td><span class="badge bg-info-subtle text-info-emphasis border border-info">@e.Category</span></td>
                                <td style="max-width:320px;"><small class="text-truncate d-block">@e.Description</small></td>
                                <td class="text-end pe-4 fw-semibold text-danger">₱@e.Amount.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt display-6 d-block mb-2 opacity-50"></i>
                                <span>No expenses recorded for this project.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
