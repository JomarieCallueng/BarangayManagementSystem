@model BarangayCMS.Web.Areas.Admin.Models.ReportsDashboardViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Barangay CMS - Executive Summary Report</title>
    <script src="https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.3/dist/html2pdf.bundle.min.js"></script>
    <style>
        @@page {
            size: A4 portrait;
            margin: 15mm;
        }
        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            color: #0f172a;
            margin: 0;
            padding: 24px;
            background-color: #ffffff;
        }
        
        .no-print-bar {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .btn-print {
            background-color: #2563eb;
            color: #ffffff;
            border: none;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
        }
        .btn-print:hover { background-color: #1d4ed8; }
        .btn-back {
            background-color: #64748b;
            color: #ffffff;
            border: none;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            margin-left: 8px;
            text-decoration: none;
            display: inline-block;
        }
        .btn-back:hover { background-color: #475569; }
        
        .report-header {
            text-align: center;
            border-bottom: 2px solid #0f172a;
            padding-bottom: 16px;
            margin-bottom: 24px;
        }
        .brand-name {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin: 0 0 4px 0;
            color: #0f172a;
        }
        .report-subtitle {
            font-size: 13px;
            color: #475569;
            font-weight: 600;
            text-transform: uppercase;
            margin: 0 0 6px 0;
        }
        .report-date {
            font-size: 11px;
            color: #94a3b8;
            margin: 0;
        }

        .section-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            color: #0f172a;
            border-left: 4px solid #2563eb;
            padding-left: 10px;
            margin-bottom: 14px;
        }

        .styled-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }
        .styled-table th {
            background-color: #0f172a;
            color: #ffffff;
            text-align: left;
            padding: 10px 14px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .styled-table th.text-end { text-align: right; }
        .styled-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 13px;
            color: #334155;
        }
        .styled-table tr:nth-child(even) td { background-color: #f8fafc; }
        .styled-table td.val-bold {
            font-weight: 700;
            text-align: right;
            color: #0f172a;
        }

        .report-footer {
            margin-top: 40px;
            padding-top: 16px;
            border-top: 1px dashed #cbd5e1;
            text-align: center;
            font-size: 11px;
            color: #94a3b8;
        }

        @@media print {
            .no-print-bar { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body>

    <div class="no-print-bar">
        <div>
            <button id="btnDownload" class="btn-print">⬇️ Download PDF Again</button>
            <button id="btnClose" class="btn-back">⬅️ Bumalik sa Reports</button>
        </div>
        <span id="statusText" style="font-size: 12px; color: #64748b;">Inihahanda ang iyong PDF download...</span>
    </div>

    <div id="reportContent">
    <div class="report-header">
        <h1 class="brand-name">Barangay Management System</h1>
        <div class="report-subtitle">Executive Analytics & Summary Report</div>
        <p class="report-date">Generated on: @DateTime.Now.ToString("MMMM dd, yyyy - hh:mm tt")</p>
    </div>

    <div class="section-title">System Metrics Overview</div>

    <table class="styled-table">
        <thead>
            <tr>
                <th>Metric Category</th>
                <th class="text-end">Current Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Total Registered Residents</td>
                <td class="val-bold">@Model.TotalResidents</td>
            </tr>
            <tr>
                <td>Total Blotter & Incident Cases Logged</td>
                <td class="val-bold">@Model.TotalComplaints</td>
            </tr>
            <tr>
                <td>Total Approved Budget Allocation</td>
                <td class="val-bold">₱@Model.TotalBudget.ToString("N2")</td>
            </tr>
            <tr>
                <td>Total Official Certificates Issued</td>
                <td class="val-bold">@Model.TotalCertificatesIssued</td>
            </tr>
            <tr>
                <td>Active / Ongoing Infrastructure Projects</td>
                <td class="val-bold">@Model.ActiveProjects</td>
            </tr>
            <tr>
                <td>Active Evacuees Logged</td>
                <td class="val-bold">@Model.ActiveEvacuees</td>
            </tr>
            <tr>
                <td>Total Health Center Records</td>
                <td class="val-bold">@Model.TotalHealthRecords</td>
            </tr>
        </tbody>
    </table>

    <div class="report-footer">
        This is an official system-generated executive summary document from BarangayCMS.
    </div>
    </div><!-- /#reportContent -->

    <script>
        (function () {
            var status = document.getElementById('statusText');

            function pad(n) { return n < 10 ? '0' + n : '' + n; }
            function stamp() {
                var d = new Date();
                return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            }

            function downloadPdf() {
                var element = document.getElementById('reportContent');
                var opt = {
                    margin:       [10, 10, 10, 10],
                    filename:     'Barangay_Executive_Summary_' + stamp() + '.pdf',
                    image:        { type: 'jpeg', quality: 0.98 },
                    html2canvas:  { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
                    jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                    pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
                };

                if (typeof html2pdf === 'undefined') {
                    // CDN unavailable — fall back to the browser's print-to-PDF dialog.
                    if (status) { status.textContent = 'Hindi ma-load ang PDF library — gagamitin ang Print dialog.'; }
                    window.print();
                    return;
                }

                if (status) { status.textContent = 'Ginagawa ang PDF... maghintay lamang.'; }
                html2pdf().set(opt).from(element).save().then(function () {
                    if (status) { status.textContent = 'Na-download na ang PDF sa iyong device. ✅'; }
                }).catch(function () {
                    if (status) { status.textContent = 'Nagka-problema — subukang muli ang Download PDF.'; }
                });
            }

            // Awtomatikong i-download ang PDF pagkabukas ng pahina.
            window.addEventListener('load', function () {
                setTimeout(downloadPdf, 400);
            });

            document.getElementById('btnDownload').addEventListener('click', downloadPdf);

            document.getElementById('btnClose').addEventListener('click', function () {
                window.location.href = '/Admin/Reports';
            });
        })();
    </script>
</body>
</html>