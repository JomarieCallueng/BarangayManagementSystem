@model BarangayCMS.Web.Areas.Admin.Models.ReportsDashboardViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Barangay CMS - Executive Summary Report</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
            @@media print {
                .no-print {
                    display: none !important;
                }

                body {
                    font-size: 12pt;
                    background-color: white !important;
                }
            }

            .report-header {
                border-bottom: 2px solid #333;
                padding-bottom: 10px;
                margin-bottom: 20px;
            }
    </style>
</head>
<body class="p-5" onload="window.print()">
    <div class="no-print mb-4 d-flex justify-content-between align-items-center">
        <div>
            <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer"></i> Print / Save as PDF</button>
            <button onclick="window.close()" class="btn btn-secondary">Close Window</button>
        </div>
        <small class="text-muted">Tip: Gamitin ang "Save as PDF" sa destination drop-down ng browser.</small>
    </div>

    <div class="report-header text-center">
        <h3 class="fw-bold text-uppercase mb-1">Barangay Management System</h3>
        <h5 class="text-secondary mb-2">Executive Analytics & Summary Report</h5>
        <p class="text-muted small mb-0">Generated on: @DateTime.Now.ToString("MMMM dd, yyyy - hh:mm tt")</p>
    </div>

    <div class="row my-4">
        <div class="col-12">
            <h6 class="fw-bold text-uppercase border-bottom pb-2">System Metrics Overview</h6>
            <table class="table table-bordered align-middle mt-2">
                <thead class="table-light">
                    <tr>
                        <th>Metric Category</th>
                        <th class="text-end">Current Value</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Total Registered Residents</td>
                        <td class="text-end fw-bold">@Model.TotalResidents</td>
                    </tr>
                    <tr>
                        <td>Total Blotter & Incident Cases Logged</td>
                        <td class="text-end fw-bold">@Model.TotalComplaints</td>
                    </tr>
                    <tr>
                        <td>Total Approved Budget Allocation</td>
                        <td class="text-end fw-bold">₱@Model.TotalBudget.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>Total Official Certificates Issued</td>
                        <td class="text-end fw-bold">@Model.TotalCertificatesIssued</td>
                    </tr>
                    <tr>
                        <td>Active / Ongoing Infrastructure Projects</td>
                        <td class="text-end fw-bold">@Model.ActiveProjects</td>
                    </tr>
                    <tr>
                        <td>Active Evacuees Logged</td>
                        <td class="text-end fw-bold">@Model.ActiveEvacuees</td>
                    </tr>
                    <tr>
                        <td>Total Health Center Records</td>
                        <td class="text-end fw-bold">@Model.TotalHealthRecords</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-5 pt-4 border-top text-center text-muted small">
        <p>This is a system-generated document from BarangayCMS.</p>
    </div>
</body>
</html>