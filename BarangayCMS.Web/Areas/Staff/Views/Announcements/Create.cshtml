@model BarangayCMS.Areas.Staff.ViewModels.AnnouncementViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Post Announcement";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-megaphone-fill"></i> Create Announcement</h1>
        <p class="page-header__sub">I-encode ang mga mahahalagang detalye para sa impormasyon ng publiko.</p>
    </div>
    <a asp-action="Index" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
</div>

<div class="form-page">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="app-card app-card--pad">
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold"></label>
                <input asp-for="Title" class="form-control" placeholder="Isulat ang paksa..." />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Content" class="form-label fw-semibold"></label>
                <textarea asp-for="Content" class="form-control" rows="6" placeholder="Isulat ang buong nilalaman dito..."></textarea>
                <span asp-validation-for="Content" class="text-danger small"></span>
            </div>
            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                <button type="submit" class="btn btn-brand px-4">Publish Content</button>
            </div>
        </div>
    </form>
</div>
