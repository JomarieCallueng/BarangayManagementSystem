@model BarangayCMS.Web.Areas.Staff.ViewModels.CertificateViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Request Details</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <div class="container py-5" style="max-width: 650px;">
        <div class="card border-0 shadow-sm p-4 rounded-3 mb-3">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle-fill text-info me-2"></i>Log Overview</h5>
            <div class="row g-3 small">
                <!-- Control Number -->
                <div class="col-6">
                    <span class="text-muted d-block">Control Number</span>
                    <strong class="font-monospace">@(string.IsNullOrEmpty(Model.ControlNumber) ? "N/A" : Model.ControlNumber)</strong>
                </div>

                <!-- Resident Name -->
                <div class="col-6">
                    <span class="text-muted d-block">Resident</span>
                    <strong>@Model.ResidentName</strong>
                </div>

                <!-- Certificate Type -->
                <div class="col-6">
                    <span class="text-muted d-block">Document Requested</span>
                    <strong>@Model.CertificateType</strong>
                </div>

                <!-- Purpose -->
                <div class="col-6">
                    <span class="text-muted d-block">Purpose</span>
                    <strong>@Model.Purpose</strong>
                </div>

                <!-- Date Logged / Requested -->
                <div class="col-6">
                    <span class="text-muted d-block">Date Logged</span>
                    <span class="text-secondary">@Model.DateRequested.ToString("f")</span>
                </div>

                <!-- Status -->
                <div class="col-6">
                    <span class="text-muted d-block">Status</span>
                    @if (Model.Status == "Ready for Pickup")
                    {
                        <span class="badge bg-info text-dark">Ready for Pickup</span>
                    }
                    else if (Model.Status == "Done" || Model.Status == "Issued" || Model.Status == "Approved")
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <span class="badge bg-danger">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    }
                </div>

                <!-- O.R. & Fee Details -->
                <div class="col-6">
                    <span class="text-muted d-block">Fee Paid</span>
                    <strong>₱@Model.FeePaid.ToString("N2")</strong>
                </div>

                <!-- Date Issued / Released -->
                @if (Model.DateIssued != null)
                {
                    <div class="col-12 border-top pt-2">
                        <span class="text-muted d-block">Release Date</span>
                        <span class="text-success fw-bold">@Model.DateIssued?.ToString("f")</span>
                    </div>
                }
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-sm btn-light border px-3"><i class="bi bi-arrow-left me-1"></i> Back</a>

            @if (Model.Status == "Issued" || Model.Status == "Approved" || Model.Status == "Ready for Pickup" || Model.Status == "Done")
            {
                <a asp-action="Print" asp-route-id="@Model.CertificateId" class="btn btn-sm btn-dark px-4" target="_blank">
                    <i class="bi bi-printer me-1"></i> Print Document
                </a>
            }
        </div>
    </div>
</body>
</html>