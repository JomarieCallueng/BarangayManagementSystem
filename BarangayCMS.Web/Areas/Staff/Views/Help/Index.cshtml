@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Help System";

    // (icon, name, description, step-by-step guide, tip) — Staff/Encoder scope.
    var modules = new (string Icon, string Name, string Desc, string[] Steps, string Tip)[]
    {
        ("bi-grid-1x2-fill", "Dashboard", "Buod ng mga gawain at datos na naa-access ng Staff/Encoder.",
            new[] {
                "Click \"Dashboard\" in the sidebar.",
                "Review the summary of records and activity you can access.",
                "Use it as your starting point, then open the module you need."
            },
            "Figures come from the database — refresh the page if a change doesn't appear yet."),

        ("bi-people-fill", "Residents", "Pag-encode at pag-update ng resident records.",
            new[] {
                "Click \"Residents\" in the sidebar.",
                "Click \"Add Resident\" and fill in the name, address and contact details.",
                "Click \"Save\".",
                "Use the search box to find a resident, then Edit to update the record."
            },
            "Make sure the details are complete and correct before saving."),

        ("bi-file-earmark-text-fill", "Certificates", "Pag-encode at pagproseso ng certificate requests ng residente.",
            new[] {
                "Click \"Certificates\" in the sidebar.",
                "Open a request to review the resident's details and requirements.",
                "Encode any missing information and update the status.",
                "Coordinate with the Admin for approval/release when required."
            },
            "Check that the requirements are complete before processing a request."),

        ("bi-chat-left-text-fill", "Complaints", "Pagtanggap at pag-log ng mga reklamo ng residente.",
            new[] {
                "Click \"Complaints\" in the sidebar.",
                "Log a new complaint or open an existing one.",
                "Record the details and update the status as it is handled."
            },
            "Keep statuses current so concerns are properly tracked."),

        ("bi-exclamation-triangle-fill", "Disaster Risk", "Pag-encode ng disaster incidents at lokasyon para sa records ng barangay.",
            new[] {
                "Click \"Disaster Risk\" in the sidebar.",
                "Use \"Log Emergency Incident\" to record an incident (type, description, location).",
                "Save the record so it is added to the barangay's logs."
            },
            "Encode the location clearly so the record is easy to find later."),

        ("bi-tree-fill", "Environment", "Pagtatala ng mga aktibidad at programang pangkalikasan.",
            new[] {
                "Click \"Environment\" in the sidebar.",
                "Record an environmental activity or program.",
                "Save the entry and update it later if needed."
            },
            "Log activities as they happen to keep the records up to date."),

        ("bi-heart-pulse-fill", "Health Center", "Pag-encode ng mga health records/serbisyo.",
            new[] {
                "Click \"Health Center\" in the sidebar.",
                "Add or update the health record or service.",
                "Save each entry; use search to find existing records."
            },
            "Double-check the details before saving."),

        ("bi-megaphone-fill", "Announcements", "Pag-encode ng mga anunsyo para sa publiko.",
            new[] {
                "Click \"Announcements\" in the sidebar.",
                "Click \"Add Announcement\" and enter the title and content.",
                "Save it so it appears for the public."
            },
            "Keep announcements clear and dated."),

        ("bi-graph-up", "Reports", "Pagtingin/pagbuo ng mga ulat mula sa naka-encode na datos.",
            new[] {
                "Click \"Reports\" in the sidebar.",
                "Choose the report you need.",
                "Review the figures on screen, then export or print if needed."
            },
            "Reports are built from encoded data — keep your records accurate."),
    };
}

@section Styles {
    <style>
        /* ===== Help Center — hero + topic-card grid (theme-token driven). ===== */
        .help-hero {
            position: relative;
            background: var(--hero-bg);
            color: var(--hero-text);
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            padding: 2.5rem 1.5rem 2.75rem;
            text-align: center;
            overflow: hidden;
        }
        .help-hero__icon {
            width: 68px; height: 68px; margin: 0 auto 1rem;
            border-radius: 50%; display: grid; place-items: center;
            font-size: 2rem; background: rgba(255,255,255,.15); color: #fff;
            border: 1px solid rgba(255,255,255,.22);
        }
        /* Scoped under .help-hero so it beats the global `.app-content h1` colour. */
        .help-hero .help-hero__title { font-weight: 800; font-size: clamp(1.5rem, 3.2vw, 2.1rem); margin: 0 0 .5rem; color: #fff; }
        .help-hero__sub { max-width: 34rem; margin: 0 auto 1.5rem; color: rgba(255,255,255,.8); font-size: .95rem; line-height: 1.6; }
        .help-hero__search { max-width: 40rem; margin: 0 auto; }
        .help-hero__search .input-group { background: #fff; border-radius: 999px; box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.18); overflow: hidden; }
        .help-hero__search .form-control,
        .help-hero__search .input-group-text { border: 0; padding-top: .75rem; padding-bottom: .75rem; background: #fff; }
        .help-hero__search .form-control:focus { box-shadow: none; }
        .help-hero__search .help-hero__btn {
            border: 0; border-radius: 999px; margin: .3rem .3rem .3rem 0; padding-inline: 1.4rem;
            font-weight: 600; background: var(--accent); color: #fff;
        }
        .help-hero__search .help-hero__btn:hover { background: var(--accent-hover); }

        .help-section-title { font-weight: 800; color: var(--heading); font-size: 1.25rem; margin: 0; }

        .help-topic-card {
            display: flex; flex-direction: column; gap: .6rem; width: 100%; text-align: left;
            font: inherit; cursor: pointer;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); box-shadow: var(--shadow); padding: 1.25rem; height: 100%;
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }
        .help-topic-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: var(--accent); }
        .help-topic-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        .help-topic-card__icon {
            width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center;
            font-size: 1.3rem; background: var(--accent-soft); color: var(--accent);
        }
        .help-topic-card__title { font-weight: 700; color: var(--heading); font-size: 1rem; margin: 0; }
        .help-topic-card__text { color: var(--muted); font-size: .85rem; line-height: 1.55; margin: 0; }
        .help-topic-card__more {
            margin-top: auto; padding-top: .35rem; font-size: .8rem; font-weight: 700; color: var(--accent);
            display: inline-flex; align-items: center; gap: .35rem;
        }
        .help-topic-card:hover .help-topic-card__more i { transform: translateX(2px); }
        .help-topic-card__more i { transition: transform .18s ease; }

        .help-modal-icon {
            width: 38px; height: 38px; border-radius: 10px; display: inline-grid; place-items: center;
            font-size: 1.05rem; background: var(--accent-soft); color: var(--accent);
        }
        .help-guide__intro { color: var(--body-text); }
        .help-guide__steps-title,
        .help-guide__tips-title { font-weight: 700; color: var(--heading); font-size: .9rem; margin: 1rem 0 .5rem; display: flex; align-items: center; gap: .4rem; }
        .help-guide__steps { padding-left: 1.15rem; margin: 0; }
        .help-guide__steps li { margin-bottom: .5rem; line-height: 1.55; }
        .help-guide__tips { margin-top: 1rem; background: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--radius); padding: .85rem 1rem; }
        .help-guide__tips-title { margin-top: 0; color: var(--accent); }
        .help-guide__tips p { margin: 0; font-size: .88rem; line-height: 1.55; }

        .help-manual-btn { transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease; }
        .help-manual-btn:hover,
        .help-manual-btn:focus-visible { transform: translateY(-1px); box-shadow: 0 .4rem .9rem rgba(220,53,69,.35); }

        @@media (prefers-reduced-motion: reduce) {
            .help-topic-card, .help-manual-btn, .help-topic-card__more i { transition: none; }
            .help-topic-card:hover, .help-manual-btn:hover { transform: none; }
        }
    </style>
}

<!-- Slim action bar: keep the User Manual download accessible -->
<div class="d-flex justify-content-end mb-3">
    <a asp-area="Staff" asp-controller="Help" asp-action="Manual" download="User-Manual.pdf"
       class="btn btn-danger help-manual-btn fw-semibold rounded-3">
        <i class="bi bi-file-earmark-pdf-fill me-2"></i>Download User Manual
    </a>
</div>

<!-- 🎯 HERO with prominent search -->
<section class="help-hero mb-4">
    <div class="help-hero__icon"><i class="bi bi-question-lg"></i></div>
    <h1 class="help-hero__title">Help System</h1>
    <p class="help-hero__sub">Ano ang ginagawa ng bawat module at paano ito gamitin. Mag-browse ng paksa o maghanap.</p>
    <div class="help-hero__search">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="helpSearch" class="form-control"
                   placeholder="Search help topics…" autocomplete="off" aria-label="Search help topics" />
            <button type="button" id="helpSearchClear" class="btn btn-link text-muted d-none px-2"
                    title="Clear" aria-label="Clear search"><i class="bi bi-x-lg"></i></button>
            <button type="button" id="helpSearchBtn" class="help-hero__btn"><i class="bi bi-search me-1"></i>Search</button>
        </div>
    </div>
</section>

<div class="alert alert-info border-0 shadow-sm small">
    <i class="bi bi-info-circle me-1"></i> Ang gabay na ito ay para sa mga module na aktwal na naa-access ng Staff/Encoder.
</div>

<!-- 🗂️ BROWSE BY TOPIC -->
<div class="d-flex align-items-center justify-content-between mt-4 mb-3">
    <h2 class="help-section-title">Browse by topic</h2>
    <span id="helpResultCount" class="text-muted small text-nowrap"></span>
</div>

<div class="row g-3" id="helpGrid">
    @foreach (var m in modules)
    {
        <div class="col-12 col-sm-6 col-lg-4" data-help-item data-help-title="@m.Name" data-help-text="@m.Desc">
            <button type="button" class="help-topic-card"
                    data-bs-toggle="modal" data-bs-target="#helpTopicModal"
                    data-help-title="@m.Name" data-help-icon="@m.Icon">
                <span class="help-topic-card__icon"><i class="bi @m.Icon"></i></span>
                <span class="help-topic-card__title">@m.Name</span>
                <span class="help-topic-card__text">@m.Desc</span>
                <span class="help-topic-card__more">View guide <i class="bi bi-arrow-right"></i></span>
                @* Guide body cloned into the modal: intro + step-by-step directions + a tip. *@
                <template class="help-topic-card__guide">
                    <p class="help-guide__intro">@m.Desc</p>
                    <div class="help-guide__steps-title"><i class="bi bi-list-check"></i> Step-by-step</div>
                    <ol class="help-guide__steps">
                        @foreach (var step in m.Steps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                    @if (!string.IsNullOrWhiteSpace(m.Tip))
                    {
                        <div class="help-guide__tips">
                            <div class="help-guide__tips-title"><i class="bi bi-lightbulb"></i> Tip</div>
                            <p>@m.Tip</p>
                        </div>
                    }
                </template>
            </button>
        </div>
    }
</div>

<!-- Empty state kapag walang tugma -->
<div id="helpNoResults" class="alert alert-light border text-center text-muted d-none mt-3">
    <i class="bi bi-search me-1"></i> No help topics found. <a href="#" id="helpNoResultsReset" class="alert-link">Clear search</a>
</div>

<div class="card border-0 shadow-sm rounded mt-4">
    <div class="card-body small">
        <h6 class="fw-bold mb-2"><i class="bi bi-lightbulb text-warning me-1"></i> Mga karaniwang tip</h6>
        <ul class="mb-0">
            <li>Siguraduhing kumpleto at wasto ang na-encode bago i-save.</li>
            <li>Kapag hindi lumabas ang bagong record, i-refresh ang listahan.</li>
            <li>Para sa mga gawaing hindi kasama sa iyong access, makipag-ugnayan sa Admin.</li>
        </ul>
    </div>
</div>

<!-- 📖 GUIDE MODAL (shared, populated from the clicked topic card) -->
<div class="modal fade" id="helpTopicModal" tabindex="-1" aria-labelledby="helpTopicModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2" id="helpTopicModalLabel">
                    <span class="help-modal-icon" id="helpTopicModalIcon"><i class="bi bi-question-lg"></i></span>
                    <span id="helpTopicModalTitle">Help System</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="helpTopicModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Close</button>
                <a asp-area="Staff" asp-controller="Help" asp-action="Manual" download="User-Manual.pdf" class="btn btn-danger help-manual-btn">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i>Download User Manual
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ---- Live, case-insensitive filter over the topic cards ----
            var search = document.getElementById('helpSearch');
            var clearBtn = document.getElementById('helpSearchClear');
            var searchBtn = document.getElementById('helpSearchBtn');
            var noResults = document.getElementById('helpNoResults');
            var resetLink = document.getElementById('helpNoResultsReset');
            var counter = document.getElementById('helpResultCount');
            var grid = document.getElementById('helpGrid');
            var items = Array.prototype.slice.call(document.querySelectorAll('[data-help-item]'));

            function apply() {
                var q = search.value.trim().toLowerCase();
                var terms = q.split(/\s+/).filter(Boolean);
                var visible = 0;
                items.forEach(function (it) {
                    var hay = ((it.getAttribute('data-help-title') || '') + ' ' +
                               (it.getAttribute('data-help-text') || '')).toLowerCase();
                    var match = terms.length === 0 || terms.every(function (t) { return hay.indexOf(t) !== -1; });
                    it.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                noResults.classList.toggle('d-none', visible !== 0);
                clearBtn.classList.toggle('d-none', q.length === 0);
                if (counter) counter.textContent = q ? (visible + (visible === 1 ? ' topic' : ' topics')) : '';
            }

            function reset(ev) {
                if (ev) ev.preventDefault();
                search.value = '';
                apply();
                search.focus();
            }

            if (search) {
                search.addEventListener('input', apply);
                clearBtn.addEventListener('click', reset);
                if (resetLink) resetLink.addEventListener('click', reset);
                if (searchBtn) searchBtn.addEventListener('click', function () {
                    apply();
                    if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
                search.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); apply(); } });
                apply();
            }

            // ---- Guide modal: populate from the clicked topic card ----
            var modal = document.getElementById('helpTopicModal');
            if (modal) {
                var titleEl = document.getElementById('helpTopicModalTitle');
                var iconEl = document.getElementById('helpTopicModalIcon');
                var bodyEl = document.getElementById('helpTopicModalBody');

                modal.addEventListener('show.bs.modal', function (event) {
                    var card = event.relatedTarget;
                    if (!card) return;
                    titleEl.textContent = card.getAttribute('data-help-title') || '';
                    var iconClass = card.getAttribute('data-help-icon') || 'bi-question-lg';
                    iconEl.innerHTML = '<i class="bi ' + iconClass + '"></i>';
                    var guide = card.querySelector('.help-topic-card__guide');
                    bodyEl.innerHTML = '';
                    if (guide && guide.content) {
                        bodyEl.appendChild(guide.content.cloneNode(true));
                    } else if (guide) {
                        bodyEl.innerHTML = guide.innerHTML;
                    }
                });
            }
        })();
    </script>
}
