@model IEnumerable<BarangayCMS.Areas.Staff.ViewModels.ResidentViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Resident Demographic Registry";
}

<div class="container-fluid p-0">
    <!-- Top Action Row -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="text-muted small">Dashboard</span>
            <h2 class="fw-bold m-0 text-dark" style="font-size: 1.5rem;">Resident Demographic Registry</h2>
        </div>
        <div>
            <a asp-area="Staff" asp-controller="Residents" asp-action="Create" class="btn btn-primary fw-semibold px-4 shadow-sm">
                <i class="bi bi-person-plus me-1"></i> Register Citizen
            </a>
        </div>
    </div>

    <!-- FILTER AND SEARCH BAR (AUTO-SUBMIT ON PUROK SELECT) -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white rounded-3">
        <form id="filterForm" method="get" asp-area="Staff" asp-controller="Residents" asp-action="Index" class="row g-2 align-items-center">

            <!-- Auto-Submit Purok Filter Dropdown -->
            <div class="col-md-4 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                    </span>
                    <!-- 💡 IDINAGDAG ANG onchange="this.form.submit()" DITO -->
                    <select name="purokFilter"
                            asp-items="ViewBag.PurokList"
                            class="form-select border-start-0 bg-light"
                            onchange="this.form.submit()">
                        <option value="">-- Lahat ng Purok (All Residents) --</option>
                    </select>
                </div>
            </div>

            <!-- Search Input Box -->
            <div class="col-md-5 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.CurrentSearch"
                           class="form-control border-start-0 bg-light"
                           placeholder="Maghanap ng pangalan ng residente..." />
                </div>
            </div>

            <!-- Search & Reset Buttons -->
            <div class="col-md-3 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string) || !string.IsNullOrEmpty(ViewBag.CurrentPurok as string))
                {
                    <a asp-area="Staff" asp-controller="Residents" asp-action="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Data Table Container Wrapped in Clean White Card Look -->
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-uppercase tracking-wider text-secondary" style="font-size: 0.75rem; font-weight: 600;">
                        <th>Full Name</th>
                        <th>Gender</th>
                        <th>Civil Status</th>
                        <th>Contact</th>
                        <th>Voter Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">
                                    @item.LastName, @item.FirstName @item.MiddleName
                                </td>
                                <td>@item.Gender</td>
                                <td>@item.CivilStatus</td>
                                <td class="text-muted">@item.ContactNumber</td>
                                <td>
                                    @if (item.IsVoter)
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded">Voter</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded">Non-Voter</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-area="Staff"
                                       asp-controller="Residents"
                                       asp-action="Details"
                                       asp-route-id="@item.ResidentId"
                                       class="btn btn-sm btn-outline-secondary px-3">
                                        View Profile
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted small">
                                <i class="bi bi-folder-x fs-3 d-block mb-2 text-secondary"></i>
                                Walang nakitang record ng mga residente na tumutugma sa iyong hinahanap.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>