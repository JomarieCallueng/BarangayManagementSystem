@model BarangayCMS.Areas.Staff.ViewModels.DisasterViewModel
@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Log Incident Report";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-exclamation-triangle-fill"></i> Crisis Response Logging Form</h1>
        <p class="page-header__sub">I-tala ang impormasyon tungkol sa sakuna o emergency sa barangay.</p>
    </div>
    <a asp-action="Index" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
</div>

<div class="form-page">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="app-card app-card--pad">

            <div class="mb-3">
                <label asp-for="IncidentName" class="form-label fw-semibold"></label>
                <input asp-for="IncidentName" class="form-control" placeholder="e.g., Bagyong Egay Flooding, Sunog sa Purok 5" />
                <span asp-validation-for="IncidentName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DisasterType" class="form-label fw-semibold"></label>
                <input asp-for="DisasterType" class="form-control" placeholder="e.g., Flash Flood, Earthquake, Structural Collapse" />
                <span asp-validation-for="DisasterType" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label fw-semibold"></label>
                <input asp-for="Location" class="form-control" placeholder="Saan partikular na lugar o purok nangyari..." />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OccurrenceDate" class="form-label fw-semibold"></label>
                <input asp-for="OccurrenceDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="OccurrenceDate" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Ilarawan ang kasalukuyang sitwasyon o lawak ng pinsala..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                <button type="submit" class="btn btn-brand px-4">Submit Crisis Log</button>
            </div>
        </div>
    </form>
</div>
