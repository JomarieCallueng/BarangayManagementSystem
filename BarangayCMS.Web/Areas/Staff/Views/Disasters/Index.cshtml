@using BarangayCMS.DTO
@model IEnumerable<BarangayCMS.Areas.Staff.ViewModels.DisasterViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Disaster Risk & Emergency Response";
    var evac = ViewBag.Evacuation as PublicEvacuationDTO;
    var evacStatus = evac?.Status?.NormalizedStatus ?? "NORMAL";
    string evacBadge = evacStatus == "ACTIVE" ? "bg-danger" : evacStatus == "PREPARED" ? "bg-warning text-dark" : "bg-success";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <small class="text-muted text-uppercase fw-bold">Safety</small>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-shield-fill-exclamation text-primary me-2"></i>Disaster Risk & Evacuation</h2>
        <p class="text-muted small mb-0">Monitor evacuation tracking, calamity supply distribution, and safety logs.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-danger fw-semibold px-4 shadow-sm">
            <i class="bi bi-shield-plus me-1"></i> Log Emergency Incident
        </a>
    </div>
</div>

@* 🏫 EVACUATION SNAPSHOT (read-only) — mula sa Evacuation module na pinamamahalaan ng Admin *@
@if (evac != null)
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-house-door-fill text-danger me-2"></i>Evacuation Status</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @evacBadge">@evacStatus</span>
                    <a href="/Admin/Disaster/EvacuationCenters" class="btn btn-sm btn-outline-danger fw-semibold"><i class="bi bi-gear-fill me-1"></i>Manage</a>
                </div>
            </div>

            @if (evac.ActiveCenters != null && evac.ActiveCenters.Any())
            {
                <div class="row g-2 mb-2">
                    <div class="col-6 col-md-3"><div class="border rounded p-2 text-center"><div class="fw-bold text-dark">@evac.ActiveCenters.Count</div><div class="small text-muted">Active Centers</div></div></div>
                    <div class="col-6 col-md-3"><div class="border rounded p-2 text-center"><div class="fw-bold text-dark">@evac.TotalCapacity</div><div class="small text-muted">Capacity</div></div></div>
                    <div class="col-6 col-md-3"><div class="border rounded p-2 text-center"><div class="fw-bold text-warning">@evac.TotalOccupants</div><div class="small text-muted">Occupants</div></div></div>
                    <div class="col-6 col-md-3"><div class="border rounded p-2 text-center"><div class="fw-bold text-success">@evac.TotalAvailableSlots</div><div class="small text-muted">Available</div></div></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 small">
                        <thead class="text-secondary"><tr><th>Center</th><th>Location</th><th class="text-center">Occupants</th><th class="text-center">Available</th><th class="text-center">Status</th></tr></thead>
                        <tbody>
                            @foreach (var c in evac.ActiveCenters)
                            {
                                var oc = c.OccupancyStatus;
                                var b = oc == "FULL" ? "bg-danger" : oc == "NEAR CAPACITY" ? "bg-warning text-dark" : oc == "CLOSED" ? "bg-secondary" : "bg-success";
                                <tr>
                                    <td class="fw-semibold text-dark">@c.Name</td>
                                    <td class="text-secondary">@c.Address @(string.IsNullOrWhiteSpace(c.SitioPurok) ? "" : $"({c.SitioPurok})")</td>
                                    <td class="text-center">@c.CurrentOccupants / @c.Capacity</td>
                                    <td class="text-center fw-semibold">@c.AvailableSlots</td>
                                    <td class="text-center"><span class="badge @b">@oc</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>Walang aktibong evacuation center sa kasalukuyan.</p>
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small fw-bold">
                    <tr>
                        <th class="ps-4 py-3">Incident / Calamity Name</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Date</th>
                        <th class="py-3">Impact (HH / Indiv)</th>
                        <th class="py-3">Evac Center</th>
                        <th class="py-3">Relief Dist.</th>
                        <th class="text-end pe-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-sun display-6 d-block mb-2 text-success"></i>
                                Ligtas ang komunidad. Walang aktibong kalamidad o insidente.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@item.IncidentName</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark px-2.5 py-1.5 rounded">
                                        @item.DisasterType
                                    </span>
                                </td>
                                <td class="text-secondary">@item.OccurrenceDate.ToString("MMM dd, yyyy")</td>
                                <td class="fw-semibold text-dark">
                                    <span class="text-danger">@item.AffectedHouseholdsCount HH</span> /
                                    <span class="text-secondary">@item.DisplacedIndividualsCount Pax</span>
                                </td>
                                <td>
                                    @if (item.EvacuationCenterStatus == "Open")
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded fw-medium">OPEN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1 rounded fw-medium">Closed</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ReliefDistributionStatus?.ToLower() == "completed")
                                    {
                                        <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Completed</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning fw-semibold"><i class="bi bi-hourglass-split me-1"></i>Ongoing</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Manage" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-2">
                                        <i class="bi bi-gear-fill"></i> Track
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-danger-subtle {
        background-color: #ffeef2;
    }

    .bg-secondary-subtle {
        background-color: #f1f3f5;
    }
</style>