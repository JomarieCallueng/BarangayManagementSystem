@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Barangay Staff</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Loaded in <head>, before the body paints, so the saved palette is applied with no flash of the default theme. *@
    <script src="~/js/theme-switcher.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell" id="appShell">
        <div class="app-sidebar__backdrop no-print" onclick="document.getElementById('appShell').classList.remove('is-open')"></div>

        <!-- SIDEBAR -->
        <aside class="app-sidebar no-print">
            <div class="app-sidebar__brand">
                <i class="bi bi-person-badge-fill"></i>
                <div>
                    <h6 class="app-sidebar__brand-title">Barangay Staff</h6>
                    <span class="app-sidebar__brand-sub">Encoder Portal</span>
                </div>
            </div>

            <nav class="app-nav">
                <a asp-area="Staff" asp-controller="StaffDashboard" asp-action="Index" class="app-nav__link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
                <a asp-area="Staff" asp-controller="Residents" asp-action="Index" class="app-nav__link"><i class="bi bi-people-fill"></i> Residents</a>
                <a asp-area="Staff" asp-controller="Certificates" asp-action="Index" class="app-nav__link"><i class="bi bi-file-earmark-text-fill"></i> Certificates</a>
                <a asp-area="Staff" asp-controller="Complaints" asp-action="Index" class="app-nav__link"><i class="bi bi-chat-left-text-fill"></i> Complaints</a>
                <a asp-area="Staff" asp-controller="Disasters" asp-action="Index" class="app-nav__link"><i class="bi bi-exclamation-triangle-fill"></i> Disaster Risk</a>
                <a asp-area="Staff" asp-controller="Environments" asp-action="Index" class="app-nav__link"><i class="bi bi-tree-fill"></i> Environment</a>
                <a asp-area="Staff" asp-controller="Health" asp-action="Index" class="app-nav__link"><i class="bi bi-heart-pulse-fill"></i> Health Center</a>
                <a asp-area="Staff" asp-controller="Announcements" asp-action="Index" class="app-nav__link"><i class="bi bi-megaphone-fill"></i> Announcements</a>
                <a asp-area="Staff" asp-controller="Reports" asp-action="Index" class="app-nav__link"><i class="bi bi-graph-up"></i> Reports</a>

                <hr class="app-nav__divider" />
                <a href="#" data-bs-toggle="modal" data-bs-target="#logoutModal" class="app-nav__link app-nav__link--danger">
                    <i class="bi bi-box-arrow-left"></i> Log Out
                </a>
            </nav>

            <div class="app-sidebar__foot">© 2026 Barangay MIS</div>
        </aside>

        <!-- MAIN COLUMN -->
        <div class="app-main">
            <header class="app-topbar no-print">
                <div class="d-flex align-items-center gap-2">
                    <button class="app-sidebar-toggle" type="button" aria-label="Toggle menu"
                            onclick="document.getElementById('appShell').classList.toggle('is-open')">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="app-topbar__title"><i class="bi bi-calendar3 me-1"></i> Encoder Session Active</span>
                </div>
                <div class="app-topbar__actions">
                    <div class="dropdown">
                        <button class="btn btn-light btn-sm dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i> Staff Encoder
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                            <li><a class="dropdown-item small py-2 text-danger" href="#" data-bs-toggle="modal" data-bs-target="#logoutModal"><i class="bi bi-power me-2"></i>Sign Out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer no-print">
                &copy; 2026 Comprehensive Barangay Management and Service System &middot; Encoder Portal
            </footer>
        </div>
    </div>

    <!-- LOG OUT CONFIRMATION MODAL -->
    <div class="modal fade no-print" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-body text-center p-4">
                    <div class="mb-3"><i class="bi bi-box-arrow-left text-danger display-4"></i></div>
                    <h5 class="fw-bold text-dark mb-2" id="logoutModalLabel">Confirm Log Out</h5>
                    <p class="text-muted small mb-4">Are you sure you want to log out from the Encoder Portal? Unsaved changes might not be saved.</p>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-light w-50 py-2 fw-semibold border rounded-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger w-50 py-2 fw-semibold rounded-3">Yes, Log Out</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Floating appearance switcher: Civic Navy / Coastal Teal / Midnight Slate. *@
    <partial name="~/Views/Shared/_ThemeSwitcher.cshtml" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Wire up the floating appearance switcher.
        if (window.BmsTheme) { window.BmsTheme.initSwitcher(); }

        // Highlight the active sidebar link based on the current URL.
        (function () {
            var path = window.location.pathname.toLowerCase().replace(/\/+$/, "");
            var links = document.querySelectorAll(".app-sidebar .app-nav__link");
            var best = null, bestLen = -1;
            links.forEach(function (link) {
                var href = (link.getAttribute("href") || "").toLowerCase().replace(/\/+$/, "");
                if (href && href !== "#" && (path === href || path.indexOf(href + "/") === 0) && href.length > bestLen) {
                    best = link; bestLen = href.length;
                }
            });
            if (!best && (path === "/staff" || path.indexOf("/staff/staffdashboard") === 0)) {
                best = document.querySelector('.app-nav__link[href*="StaffDashboard"]');
            }
            if (best) { best.classList.add("active"); }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
