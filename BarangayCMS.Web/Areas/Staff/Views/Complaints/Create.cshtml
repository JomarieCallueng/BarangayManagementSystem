@model BarangayCMS.Areas.Staff.ViewModels.ComplaintViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "New Incident Intake Form";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-file-earmark-medical"></i> New Incident Intake Form</h1>
        <p class="page-header__sub">I-rekord ang pormal na reklamo mula sa isang residente ng barangay.</p>
    </div>
    <a asp-area="Staff" asp-controller="Complaints" asp-action="Index" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
</div>

<div class="form-page">
    <form asp-area="Staff" asp-controller="Complaints" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="app-card app-card--pad">

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Complainant Dropdown Field -->
            <div class="mb-3">
                <label asp-for="ResidentId" class="form-label fw-semibold">Complainant Name</label>
                <select asp-for="ResidentId" asp-items="ViewBag.ResidentsList" class="form-select">
                    <option value="">-- Pumili ng Residente --</option>
                </select>
                <span asp-validation-for="ResidentId" class="text-danger small"></span>
            </div>

            <!-- Subject Field -->
            <div class="mb-3">
                <label asp-for="Subject" class="form-label fw-semibold">Case Subject / Nature of Complaint</label>
                <input asp-for="Subject" class="form-control" placeholder="e.g., Land Dispute, Public Disturbance" />
                <span asp-validation-for="Subject" class="text-danger small"></span>
            </div>

            <!-- Description Field -->
            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold">Detailed Incident Narrative</label>
                <textarea asp-for="Description" rows="5" class="form-control" placeholder="Isulat ang kronolohikal na detalye ng pangyayari..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Hidden Status Default for New Logs -->
            <input type="hidden" asp-for="Status" value="Pending" />

            <!-- Action Control Buttons -->
            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                <a asp-area="Staff" asp-controller="Complaints" asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                <button type="submit" class="btn btn-brand px-4">Log Complaint</button>
            </div>
        </div>
    </form>
</div>
