@model BarangayCMS.Areas.Staff.ViewModels.HealthViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Patient Medical History";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-clipboard2-heart-fill"></i> Patient Medical History</h1>
        <p class="page-header__sub">Kumpletong medikal na tala para kay @Model.ResidentName.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary fw-semibold rounded-3"><i class="bi bi-pencil-square me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="app-card app-card--pad text-center mb-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                 style="width:84px;height:84px;background:var(--accent-soft);color:var(--accent);font-size:2.4rem;">
                <i class="bi bi-person-heart"></i>
            </div>
            <h4 class="fw-bold mb-1" style="color:var(--heading);">@Model.ResidentName</h4>
            <span class="badge bg-info-subtle text-info-emphasis rounded-pill">@Model.HealthClassification</span>
            <div class="mt-3">
                @if (Model.IsVaccinated)
                {
                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2"><i class="bi bi-shield-check me-1"></i>Vaccinated</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-2"><i class="bi bi-shield-x me-1"></i>Not Vaccinated</span>
                }
            </div>
        </div>

        <div class="app-card app-card--pad">
            <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-activity me-1"></i> Vital Signs</h6>
            <div class="row text-center g-2">
                <div class="col-4">
                    <div class="p-2 rounded-3" style="background:var(--surface-alt);">
                        <div class="fw-bold" style="font-size:1.3rem;color:var(--heading);">@(Model.WeightKg > 0 ? Model.WeightKg.ToString("0.#") : "—")</div>
                        <div class="text-muted" style="font-size:.72rem;">Weight (kg)</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 rounded-3" style="background:var(--surface-alt);">
                        <div class="fw-bold" style="font-size:1.3rem;color:var(--heading);">@(Model.HeightCm > 0 ? Model.HeightCm.ToString("0.#") : "—")</div>
                        <div class="text-muted" style="font-size:.72rem;">Height (cm)</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 rounded-3" style="background:var(--surface-alt);">
                        <div class="fw-bold" style="font-size:1.3rem;color:var(--accent);">@(Model.Bmi > 0 ? Model.Bmi.ToString("0.#") : "—")</div>
                        <div class="text-muted" style="font-size:.72rem;">BMI</div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                <span class="text-muted small">Blood Type</span>
                <span class="fw-bold" style="color:var(--heading);">@(string.IsNullOrEmpty(Model.BloodType) ? "N/A" : Model.BloodType)</span>
            </div>
            <div class="d-flex justify-content-between mt-2">
                <span class="text-muted small">BMI Category</span>
                <span class="fw-semibold">@Model.BmiCategory</span>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="app-card app-card--pad mb-4">
            <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-clipboard2-pulse me-1"></i> Consultation Details</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Medical Condition / Diagnosis</div>
                    <div class="fw-semibold" style="color:var(--heading);">@(string.IsNullOrEmpty(Model.MedicalCondition) ? "None" : Model.MedicalCondition)</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Attending Health Worker</div>
                    <div class="fw-semibold" style="color:var(--heading);">@(string.IsNullOrEmpty(Model.AttendingHealthWorker) ? "—" : Model.AttendingHealthWorker)</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Last Check-up</div>
                    <div class="fw-semibold" style="color:var(--heading);"><i class="bi bi-calendar-heart me-1 text-danger"></i>@Model.LastCheckupDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Date Recorded</div>
                    <div class="fw-semibold" style="color:var(--heading);"><i class="bi bi-calendar3 me-1 text-primary"></i>@Model.DateRecorded.ToString("MMMM dd, yyyy")</div>
                </div>
            </div>
        </div>

        <div class="app-card app-card--pad">
            <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-journal-medical me-1"></i> Remarks &amp; Clinical Notes</h6>
            <p class="mb-0" style="white-space:pre-line;color:var(--body-text);">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "No additional clinical notes were recorded for this consultation." : Model.Remarks)</p>
        </div>
    </div>
</div>
