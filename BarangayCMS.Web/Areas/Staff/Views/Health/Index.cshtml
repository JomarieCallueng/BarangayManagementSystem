@model IEnumerable<BarangayCMS.Areas.Staff.ViewModels.HealthViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Barangay Health Center Desk";

    var records = Model?.ToList() ?? new List<BarangayCMS.Areas.Staff.ViewModels.HealthViewModel>();
    var totalRecords = records.Count;
    var uniquePatients = records.Select(r => r.ResidentId).Distinct().Count();
    var vaccinated = records.Count(r => r.IsVaccinated);
    var vaxRate = totalRecords > 0 ? (int)Math.Round(vaccinated * 100.0 / totalRecords) : 0;
    var latest = records.Any() ? records.Max(r => r.LastCheckupDate) : (DateTime?)null;
}

<div class="page-header">
    <div>
        <small class="text-muted text-uppercase fw-bold">Medical</small>
        <h1 class="page-header__title"><i class="bi bi-heart-pulse-fill"></i> Health Center Records</h1>
        <p class="page-header__sub">Monitor maternal health profiles, vital signs, immunization records, and medical consultations.</p>
    </div>
    <a asp-action="Create" class="btn btn-success fw-semibold px-4 shadow-sm rounded-3">
        <i class="bi bi-plus-lg me-1"></i> New Consultation Log
    </a>
</div>

<!-- OVERVIEW STATS -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card__icon"><i class="bi bi-clipboard2-pulse-fill"></i></div>
            <div><p class="stat-card__label">Total Records</p><p class="stat-card__value">@totalRecords</p></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card__icon"><i class="bi bi-people-fill"></i></div>
            <div><p class="stat-card__label">Unique Patients</p><p class="stat-card__value">@uniquePatients</p></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card__icon"><i class="bi bi-shield-fill-check"></i></div>
            <div><p class="stat-card__label">Vaccinated</p><p class="stat-card__value">@vaccinated <small class="text-muted fw-normal" style="font-size:.9rem;">(@vaxRate%)</small></p></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card__icon"><i class="bi bi-calendar-heart-fill"></i></div>
            <div><p class="stat-card__label">Latest Check-up</p><p class="stat-card__value" style="font-size:1.05rem;">@(latest.HasValue ? latest.Value.ToString("MMM dd, yyyy") : "—")</p></div>
        </div>
    </div>
</div>

<div class="app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Patient</th>
                    <th>Classification</th>
                    <th>Condition</th>
                    <th>BMI</th>
                    <th>Vaccinated</th>
                    <th>Last Check-up</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!records.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-activity display-6 d-block mb-2 text-secondary opacity-50"></i>
                            Walang pasyente o konsultasyon na nakatala sa registry.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in records)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold text-dark">
                                <i class="bi bi-person-heart text-danger me-1"></i> @item.ResidentName
                                <small class="d-block text-muted" style="font-size: 0.72rem;">Blood Type: @(string.IsNullOrEmpty(item.BloodType) ? "N/A" : item.BloodType)</small>
                            </td>
                            <td><span class="badge bg-info-subtle text-info-emphasis rounded-pill">@item.HealthClassification</span></td>
                            <td>
                                @if (item.MedicalCondition == "None" || string.IsNullOrEmpty(item.MedicalCondition))
                                {
                                    <span class="text-muted">None</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis fw-semibold">@item.MedicalCondition</span>
                                }
                            </td>
                            <td>
                                @if (item.Bmi > 0)
                                {
                                    <span class="fw-semibold">@item.Bmi</span>
                                    <small class="d-block text-muted" style="font-size:.72rem;">@item.BmiCategory</small>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (item.IsVaccinated)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill"><i class="bi bi-check-lg"></i> Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill"><i class="bi bi-x"></i> No</span>
                                }
                            </td>
                            <td class="text-muted small">@item.LastCheckupDate.ToString("MM/dd/yyyy")</td>
                            <td class="text-end pe-3">
                                <a asp-action="ViewRecord" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="History"><i class="bi bi-folder2-open"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
