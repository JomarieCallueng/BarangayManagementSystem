@model BarangayCMS.Areas.Staff.ViewModels.EnvironmentViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Activity Log";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="bi bi-tree-fill"></i> New Environmental Action Intake</h1>
        <p class="page-header__sub">I-rekord ang darating o natapos na proyektong pang-komunidad para sa kalikasan.</p>
    </div>
    <a asp-action="Index" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Bumalik</a>
</div>

<div class="form-page">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="app-card app-card--pad">
            <div class="mb-3">
                <label asp-for="ActivityName" class="form-label fw-semibold"></label>
                <input asp-for="ActivityName" class="form-control" placeholder="e.g., Coastal Clean-up, Waste Segregation Seminar" />
                <span asp-validation-for="ActivityName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Location" class="form-label fw-semibold"></label>
                <input asp-for="Location" class="form-control" placeholder="Saan gaganapin ang aktibidad..." />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ActivityDate" class="form-label fw-semibold"></label>
                <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="ActivityDate" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Ilista ang layunin, mga kasosyong organisasyon, o detalye ng aktibidad..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                <button type="submit" class="btn btn-brand px-4">Save Eco Log</button>
            </div>
        </div>
    </form>
</div>
