@model IEnumerable<BarangayCMS.Entities.BarangayOfficial>
@{
    ViewData["Title"] = "SK Members - Barangay Tatalon";

    var members = (Model ?? Enumerable.Empty<BarangayCMS.Entities.BarangayOfficial>()).ToList();

    // Featured = SK Chairperson/Chairman, kung mayroon.
    bool IsChair(BarangayCMS.Entities.BarangayOfficial o)
    {
        var p = (o.Position ?? string.Empty).ToLowerInvariant();
        return p.Contains("chair");
    }

    var chair = members.FirstOrDefault(IsChair);
    var kagawads = members.Where(o => o != chair).ToList();

    // Ordering: Chairperson (lead) first, then Secretary + Treasurer side-by-side,
    // then the remaining SK members.
    bool IsSecretary(BarangayCMS.Entities.BarangayOfficial o) => (o.Position ?? string.Empty).ToLowerInvariant().Contains("secretary");
    bool IsTreasurer(BarangayCMS.Entities.BarangayOfficial o) => (o.Position ?? string.Empty).ToLowerInvariant().Contains("treasurer");

    var skSecretary = kagawads.FirstOrDefault(IsSecretary);
    var skTreasurer = kagawads.FirstOrDefault(IsTreasurer);
    var skRest = kagawads.Where(o => o != skSecretary && o != skTreasurer).ToList();

    var orderedMembers = new List<BarangayCMS.Entities.BarangayOfficial>();
    if (chair != null) orderedMembers.Add(chair);
    if (skSecretary != null) orderedMembers.Add(skSecretary);
    if (skTreasurer != null) orderedMembers.Add(skTreasurer);
    orderedMembers.AddRange(skRest);

    // ViewData copy na nagmamarka sa featured card (SK Chairperson).
    var featuredData = new ViewDataDictionary(ViewData) { ["Featured"] = true };

    var servantsData = new ViewDataDictionary(ViewData)
    {
        ["ServantsTitle"] = "Your SK Public Servants",
        ["ServantsLeadId"] = chair?.BarangayOfficialId
    };
}

<!-- HERO -->
<section class="people-hero">
    <div class="people-hero__inner">
        <span class="people-hero__eyebrow"><i class="bi bi-people-fill"></i> Sangguniang Kabataan</span>
        <h1 class="people-hero__title">Sangguniang Kabataan (SK)</h1>
        <p class="people-hero__sub">
            The youth council representing young people and supporting youth development
            programs in the community. Ang tinig ng kabataan ng Barangay Tatalon.
        </p>
    </div>
</section>

<div class="container people-wrap py-5">

    @if (!members.Any())
    {
        <!-- EMPTY STATE -->
        <div class="people-empty">
            <i class="bi bi-people"></i>
            No SK members have been assigned.
        </div>
    }
    else
    {
        <partial name="_PublicServantsGrid" model="orderedMembers" view-data="servantsData" />
    }
</div>

<!-- PERSON-SPECIFIC HISTORY MODALS -->
@foreach (var member in members)
{
    <partial name="_OfficialHistoryModal" model="member" />
}
