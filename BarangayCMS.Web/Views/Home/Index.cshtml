@{
    ViewData["Title"] = "Home - Barangay Tatalon";
}

<!-- 🎠 HERO SECTION WITH SLIDING BACKGROUND CAROUSEL -->
<section class="hero position-relative overflow-hidden">

    <!-- 🖼️ BOOTSTRAP CAROUSEL BACKGROUND SLIDESHOW -->
    <!-- Autoplay (3s) + manual arrows/indicators + hover-pause + keyboard + touch swipe
         are all handled by the single Bootstrap carousel instance below.
         Manual navigation restarts the auto timer (see Scripts). -->
    <div id="heroCarousel"
         class="carousel slide carousel-fade hero-carousel"
         data-bs-ride="carousel"
         data-bs-interval="2500"
         data-bs-pause="hover"
         data-bs-keyboard="true"
         data-bs-touch="true"
         aria-roledescription="carousel"
         aria-label="Barangay Tatalon highlights">

        <div class="carousel-inner">

            @* Each photo slide shows the WHOLE image (object-fit: contain) so
               nothing is cropped, with a blurred, zoomed copy of the same image
               filling the band behind it — no empty side bars, no distortion. *@

            <!-- SLIDE 1: Barangay background.jpg -->
            <div class="carousel-item active">
                <div class="hero-slide">
                    <img src="/images/Barangay%20background.jpg" class="hero-slide__bg" alt="" aria-hidden="true">
                    <img src="/images/Barangay%20background.jpg" class="hero-slide__img" alt="Barangay Tatalon Banner">
                </div>
            </div>

            <!-- SLIDE 2: Kiko Del Mundo.jpg -->
            <div class="carousel-item">
                <div class="hero-slide">
                    <img src="/images/Kiko%20Del%20Mundo.jpg" class="hero-slide__bg" alt="" aria-hidden="true">
                    <img src="/images/Kiko%20Del%20Mundo.jpg" class="hero-slide__img" alt="Progresibong Tatalon Fleet">
                </div>
            </div>

            <!-- SLIDE 3: ALS.jpg -->
            <div class="carousel-item">
                <div class="hero-slide">
                    <img src="/images/ALS.jpg" class="hero-slide__bg" alt="" aria-hidden="true">
                    <img src="/images/ALS.jpg" class="hero-slide__img" alt="Barangay Tatalon ALS Program">
                </div>
            </div>

            <!-- SLIDE 4: Kiko Del Mundo Campaign Election.jpg -->
            <div class="carousel-item">
                <div class="hero-slide">
                    <img src="/images/Kiko%20Del%20Mundo%20Campaign%20Election.jpg" class="hero-slide__bg" alt="" aria-hidden="true">
                    <img src="/images/Kiko%20Del%20Mundo%20Campaign%20Election.jpg" class="hero-slide__img" alt="Kiko Del Mundo Campaign Event">
                </div>
            </div>

            <!-- SLIDE 5: Progresibong_Tatalon logo (transparent PNG) on a solid brand backdrop -->
            <div class="carousel-item">
                <div class="hero-slide hero-slide--logo">
                    <img src="/images/Progresibong_Tatalon__1_-removebg-preview.png" class="hero-slide__img" alt="Progresibong Tatalon Logo">
                </div>
            </div>

            <!-- SLIDE 6: Barangay Tatalon official seal -->
            <div class="carousel-item">
                <div class="hero-slide hero-slide--logo">
                    <img src="/images/Brgy%20Tatalon%20Seal.png" class="hero-slide__img" alt="Barangay Tatalon Official Seal">
                </div>
            </div>

            <!-- SLIDE 7: Quezon City official seal -->
            <div class="carousel-item">
                <div class="hero-slide hero-slide--logo">
                    <img src="/images/Quezon%20City%20Seal.webp" class="hero-slide__img" alt="Quezon City Official Seal">
                </div>
            </div>

        </div>

        <!-- ⚪ Slide indicators / dots (one per slide) -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Go to slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Go to slide 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Go to slide 3"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3" aria-label="Go to slide 4"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="4" aria-label="Go to slide 5"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="5" aria-label="Go to slide 6"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="6" aria-label="Go to slide 7"></button>
        </div>

        <!-- ◀️ ▶️ Manual navigation controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Previous slide">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous slide</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Next slide">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next slide</span>
        </button>
    </div>

    <!-- 📝 HERO CONTENT CONTAINER (sits above the darkened carousel) -->
    <div class="hero__inner position-relative">
        <div class="hero__content">

            <!-- 🏛️ Barangay Official Badge -->
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-25">

                <!-- 🟢 BARANGAY TATALON EMBEDDED LOGO -->
                <img id="brgyLogo"
                     src="/images/Barangay%20Tatalon%20Logo-modified.png"
                     alt="Brgy Tatalon Logo"
                     style="width: 28px; height: 28px; object-fit: contain; border-radius: 50%;" />

                <span class="small fw-semibold text-light">Barangay Tatalon • District IV, Quezon City</span>
            </div>

            <h1 class="hero__title">Komprehensibong Sistema ng Pamamahala at Pagbibigay ng Serbisyo para sa Barangay Tatalon</h1>
            <p class="hero__lead">
                Isang sentralisadong plataporma ng Barangay Tatalon upang mapabilis ang pampublikong serbisyo, paghiling ng dokumento, at pag-uulat ng mga insidente sa ating komunidad.
            </p>
            <div class="hero__actions">
                <a asp-controller="CertificateRequest" asp-action="Requirements" class="btn-hero-primary">
                    Request Certificate <i class="bi bi-chevron-right small" aria-hidden="true"></i>
                </a>
                <a asp-controller="Complaint" asp-action="Categories" class="btn-hero-ghost">
                    File a Report
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn-hero-accent">
                    <i class="bi bi-person-lock" aria-hidden="true"></i> Staff Login
                </a>
            </div>
        </div>

        <aside class="hero__figure">
            <div class="hero__figure-row"><span>Office Hours</span> <strong>Mon&ndash;Fri, 8AM&ndash;5PM</strong></div>
            <div class="hero__figure-row"><span>Emergency Hotline</span> <strong>0912-345-6789</strong></div>
            <div class="hero__figure-row"><span>Public Desk Email</span> <strong>support@barangaytatalon.gov.ph</strong></div>
            <a asp-controller="Evacuation" asp-action="Index" class="hero__figure-row text-reset text-decoration-none" style="cursor:pointer;"><span>Evacuation Centers</span> <strong>@(ViewData["ActiveEvacuationCenters"] ?? 0) Active</strong></a>
        </aside>
    </div>
</section>

<!-- 📊 DYNAMIC STATS SECTION -->
<section class="stats">
    <div class="stats__grid">
        <div>
            <p class="stats__value">8</p>
            <span class="stats__label">Service Modules</span>
        </div>
        <div>
            <p class="stats__value">@(ViewData["TotalResidents"] ?? 0)</p>
            <span class="stats__label">Registered Residents</span>
        </div>
        <div>
            <p class="stats__value">@(ViewData["ActiveEvacuationCenters"] ?? 0)</p>
            <span class="stats__label">Evacuation Centers</span>
        </div>
        <div>
            <p class="stats__value">24/7</p>
            <span class="stats__label">Emergency Line</span>
        </div>
    </div>
</section>

<!-- 🌟 ABOUT SECTION -->
<section class="section" id="about-history">
    <div class="section__inner about">
        <div>
            <span class="eyebrow">About the System</span>
            <h2 class="section__title">Isang Integrated Digital Platform para sa Barangay Tatalon</h2>
            <p class="section__text mb-3">Ang sistemang ito ay isang integrated digital platform na ginawa upang mapabilis, mapadali, at mapahusay ang mga operasyon at serbisyo ng barangay.</p>
            <p class="section__text mb-4">Layunin nitong gawing mas organisado ang records management, public service delivery, communication, at emergency response upang mas mapagsilbihan nang maayos ang mga mamamayan.</p>

            <ul class="checklist">
                <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> <span>Mabilis na paghiling ng Barangay Clearance at Permits online</span></li>
                <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> <span>Ligtas at kumpidensyal na pag-pasa ng blotter reports o sumbong</span></li>
                <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> <span>Sentralisadong census management para sa mga awtorisadong kawani</span></li>
            </ul>
        </div>

        <div class="panel">
            <div class="panel__head">
                <span class="module__icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                <div>
                    <h5 class="panel__title">Barangay Hall Information</h5>
                    <span class="stats__label">Official Public Contact Desk</span>
                </div>
            </div>
            <table class="info-table">
                <tr><td>Office Hours</td><td>Mon&ndash;Fri, 8AM&ndash;5PM</td></tr>
                <tr><td>Emergency Hotline</td><td class="is-urgent">0912-345-6789</td></tr>
                <tr><td>Public Desk Email</td><td>support@barangaytatalon.gov.ph</td></tr>
            </table>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="section__inner">
        <div class="text-center mb-5">
            <span class="eyebrow">Public &amp; Protected Features</span>
            <h2 class="section__title">Complete Service Modules</h2>
            <p class="section__text">Gabay sa mga serbisyong bukas para sa publiko at mga nangangailangan ng admin credential.</p>
        </div>

        <div class="modules">

            <article class="module">
                <div class="module__top">
                    <span class="module__icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
                    <span class="module__tag">Public Access</span>
                </div>
                <h3 class="module__title">Certificates and Permits</h3>
                <p class="module__desc">Mag-apply online para sa mga opisyal na dokumento ng barangay nang hindi pumipila.</p>
                <ul class="module__list">
                    <li>Barangay Clearance</li>
                    <li>Certificate of Residency</li>
                    <li>Indigency Certificate</li>
                </ul>
                <a asp-controller="CertificateRequest" asp-action="Requirements" class="module__link">Request Document &rarr;</a>
            </article>

            <article class="module">
                <div class="module__top">
                    <span class="module__icon"><i class="bi bi-chat-left-text" aria-hidden="true"></i></span>
                    <span class="module__tag">Public Access</span>
                </div>
                <h3 class="module__title">Complaints &amp; Incident Filing</h3>
                <p class="module__desc">Iulat nang ligtas at kumpidensyal ang mga insidente o alitan sa inyong nasasakupan.</p>
                <ul class="module__list">
                    <li>Blotter Submission</li>
                    <li>Incident Reporting</li>
                    <li>Mediation Requests</li>
                </ul>
                <a asp-controller="Complaint" asp-action="Categories" class="module__link">File a Report &rarr;</a>
            </article>

            <article class="module module--locked">
                <div class="module__top">
                    <span class="module__icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                    <span class="module__tag"><i class="bi bi-lock-fill" aria-hidden="true"></i> Staff Only</span>
                </div>
                <h3 class="module__title">Resident Information (Census)</h3>
                <p class="module__desc">Ang pamamahala ng database ng mga residente at pamilya ay para lamang sa mga awtorisadong kawani.</p>
                <ul class="module__list">
                    <li>Population Registry</li>
                    <li>Household Mapping</li>
                    <li>Demographics Logs</li>
                </ul>
                <a asp-controller="Account" asp-action="Login" class="module__link">Requires Login &rarr;</a>
            </article>

            <article class="module module--locked">
                <div class="module__top">
                    <span class="module__icon"><i class="bi bi-bar-chart" aria-hidden="true"></i></span>
                    <span class="module__tag"><i class="bi bi-lock-fill" aria-hidden="true"></i> Staff Only</span>
                </div>
                <h3 class="module__title">Internal Auditing &amp; Budget</h3>
                <p class="module__desc">Pagsubaybay sa pondo ng barangay, mga gastusin sa proyekto, at alokasyon ng kaban.</p>
                <ul class="module__list">
                    <li>Fund Allocations</li>
                    <li>Infrastructure Tracking</li>
                    <li>Financial Reports</li>
                </ul>
                <a asp-controller="Account" asp-action="Login" class="module__link">Requires Login &rarr;</a>
            </article>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // AUTO-REPLACE FALLBACK KAPAG HINDI NABASA NG SERVER ANG SPACES SA FILENAME
            const brgyImg = document.getElementById("brgyLogo");
            if (brgyImg) {
                brgyImg.onerror = function() {
                    this.outerHTML = `<i class="bi bi-shield-fill-check text-warning fs-5 me-1"></i>`;
                };
            }

            // 🎠 HERO CAROUSEL — reuse the single Bootstrap instance (no 2nd carousel).
            // Bootstrap already gives auto-advance (3s), hover-pause, keyboard at touch.
            // Idinadagdag lang natin ang timer-RESET pagkatapos ng manual navigation,
            // para hindi biglang lumipat ang slide kaagad matapos mag-click ang user.
            const heroEl = document.getElementById("heroCarousel");
            if (heroEl && window.bootstrap && bootstrap.Carousel) {
                const hero = bootstrap.Carousel.getOrCreateInstance(heroEl);

                // Restart the auto timer after a manual control click. cycle() clears any
                // existing interval first, kaya walang doble/overlapping na timer.
                heroEl.querySelectorAll("[data-bs-slide], [data-bs-slide-to]").forEach(function (ctrl) {
                    ctrl.addEventListener("click", function () { hero.cycle(); });
                });

                // I-pause habang hinahawakan sa touch device; ituloy pagkatapos.
                heroEl.addEventListener("touchstart", function () { hero.pause(); }, { passive: true });
                heroEl.addEventListener("touchend", function () { hero.cycle(); }, { passive: true });
            }
        });
    </script>
}