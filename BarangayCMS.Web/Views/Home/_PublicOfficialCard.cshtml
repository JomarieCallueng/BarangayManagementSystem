@model BarangayCMS.Entities.BarangayOfficial
@{
    var featured = ViewData["Featured"] as bool? ?? false;
    var isExOfficio = ViewData["ExOfficio"] as bool? ?? false;

    // Initials fallback kapag walang naka-upload na larawan.
    string Initials(string name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }

    // Position-based na deskripsyon (fallback dahil walang hiwalay na Description
    // field ang entity). Kung meron nang description sa DB, ito ang gagamitin.
    string DescribePosition(string? position)
    {
        var p = (position ?? string.Empty).ToLowerInvariant();
        var isSk = p.Contains("sk ") || p.StartsWith("sk") || p.Contains("kabataan") || p.Contains("youth");

        if (isSk)
        {
            if (p.Contains("chair"))
                return "Youth Leader — Leads the Sangguniang Kabataan, represents the youth, and oversees youth programs, activities, and development initiatives.";
            if (p.Contains("secretary"))
                return "Handles SK records, documentation, meeting minutes, communications, and administrative support.";
            if (p.Contains("treasurer"))
                return "Manages SK financial records, funds, collections, disbursements, and financial reporting.";
            return "Represents the interests of young people and participates in youth council decision-making, programs, and community activities.";
        }

        if (p.Contains("captain") || p.Contains("punong"))
            return "Executive Head — Leads the barangay government, oversees barangay operations and public services, and serves as the presiding officer of the Sangguniang Barangay.";
        if (p.Contains("secretary"))
            return "Manages barangay records, documentation, official communications, and administrative support.";
        if (p.Contains("treasurer"))
            return "Manages barangay finances, collections, disbursements, financial records, and related reports.";
        if (p.Contains("kagawad") || p.Contains("councilor") || p.Contains("council") || p.Contains("konsehal"))
            return "Represents community interests in the Sangguniang Barangay and participates in legislative decision-making and community programs.";
        return "Serves the barangay and its residents in the performance of official duties and community programs.";
    }

    var hasHistory = Model.ServiceHistories != null && Model.ServiceHistories.Any();
}

<div class="official-card @(featured ? "official-featured" : "")">
    <div class="official-card__photo">
        @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
        {
            <img src="~/uploads/officials/@Model.ProfileImagePath" alt="Larawan ni @Model.FullName" loading="lazy" />
        }
        else
        {
            <span class="official-card__initials">@Initials(Model.FullName)</span>
        }
    </div>

    <h3 class="official-card__name">@Model.FullName</h3>
    <span class="official-card__pos">@Model.Position</span>

    @if (isExOfficio)
    {
        <div class="official-card__exofficio"><i class="bi bi-link-45deg"></i> Ex-Officio Member</div>
    }

    @{
        // Role-based na committee (parehong panuntunan gaya ng Admin) — hindi
        // nagpapakita ng pekeng komite para sa Captain/Secretary/Treasurer.
        var committee = BarangayCMS.Web.Areas.Admin.Services.OfficialStructure.DisplayCommittee(Model.Position, Model.Committee);
    }
    @if (!string.IsNullOrWhiteSpace(committee))
    {
        <div class="official-card__committee"><i class="bi bi-diagram-3-fill me-1"></i>@committee</div>
    }
    else
    {
        <div class="official-card__committee text-muted"><i class="bi bi-dash-circle me-1"></i>No specific committee</div>
    }

    <p class="official-card__desc">@DescribePosition(Model.Position)</p>

    <span class="official-card__status"><span class="dot"></span>Active in Service</span>

    <button type="button" class="official-card__history-btn"
            data-bs-toggle="modal" data-bs-target="#historyModal-@Model.BarangayOfficialId">
        <i class="bi bi-clock-history me-1"></i>@(hasHistory ? "View Service History" : "View Term")
    </button>
</div>
