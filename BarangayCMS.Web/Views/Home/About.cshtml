@model IEnumerable<BarangayCMS.Entities.BarangayOfficial>
@{
    ViewData["Title"] = "About Us - Barangay Tatalon";

    // Maiksing helper para sa initials avatar placeholder (walang photo field ang entity).
    string Initials(string name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }
}

<style>
    /* ================= ABOUT US — scoped, theme-aware styling ================= */
    .about-hero {
        position: relative;
        overflow: hidden;
        background: var(--hero-bg);
        color: var(--hero-text);
        padding: 3.25rem 1rem 3.75rem;
        margin-bottom: 0;
    }
    .about-hero::after {
        /* soft decorative glow */
        content: "";
        position: absolute;
        top: -40%;
        right: -10%;
        width: 460px;
        height: 460px;
        background: radial-gradient(circle, rgba(255,255,255,.10) 0%, rgba(255,255,255,0) 70%);
        pointer-events: none;
    }
    .about-hero__inner { max-width: 1140px; margin: 0 auto; position: relative; z-index: 1; }
    .about-hero__eyebrow {
        display: inline-flex; align-items: center; gap: .45rem;
        padding: .35rem .85rem; border-radius: 999px; font-size: .78rem; font-weight: 600;
        letter-spacing: .02em; margin-bottom: 1rem;
        background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.28);
    }
    .about-hero__title { font-weight: 800; font-size: clamp(1.9rem, 3.6vw, 2.8rem); margin: 0 0 .6rem; }
    .about-hero__sub { color: rgba(255,255,255,.78); max-width: 46rem; font-size: 1.02rem; margin: 0 0 1.4rem; }
    .about-hero__chips { display: flex; flex-wrap: wrap; gap: .5rem; }
    .about-chip {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .5rem .95rem; border-radius: 999px; font-size: .85rem; font-weight: 600;
        color: #fff; text-decoration: none;
        background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.25);
        transition: transform .18s ease, background .18s ease;
    }
    .about-chip:hover { background: rgba(255,255,255,.22); transform: translateY(-2px); color: #fff; }

    .about-wrap { max-width: 1140px; }

    /* Lift the stats strip so it overlaps the hero for depth */
    .about-stats { margin-top: -2.25rem; position: relative; z-index: 2; }
    .about-stat {
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
        box-shadow: var(--shadow); padding: 1.1rem 1.15rem; height: 100%;
        display: flex; align-items: center; gap: .85rem;
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .about-stat:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .about-stat__icon {
        flex: 0 0 auto; width: 44px; height: 44px; border-radius: 12px;
        display: grid; place-items: center; font-size: 1.25rem;
        background: var(--accent-soft); color: var(--accent);
    }
    .about-stat__value { font-weight: 800; font-size: 1.15rem; color: var(--heading); line-height: 1.1; }
    .about-stat__label { font-size: .8rem; color: var(--muted); }

    /* Section heading */
    .about-eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .74rem; font-weight: 700; color: var(--accent); }
    .about-h2 { font-weight: 800; color: var(--heading); font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin: .15rem 0 0; }

    /* Card base */
    .about-card {
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
        box-shadow: var(--shadow); padding: 1.75rem;
    }

    /* Vision / Mission */
    .about-vm {
        position: relative; height: 100%; overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .about-vm:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
    .about-vm::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 5px; }
    .about-vm--vision::before { background: var(--brand-soft); }
    .about-vm--mission::before { background: var(--accent); }
    .about-vm__icon {
        width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center;
        font-size: 1.5rem; margin-bottom: .9rem;
    }
    .about-vm--vision .about-vm__icon { background: rgba(30,58,138,.12); color: var(--brand-soft); }
    .about-vm--mission .about-vm__icon { background: var(--accent-soft); color: var(--accent); }
    .about-vm__title { font-weight: 800; color: var(--heading); margin: 0 0 .6rem; font-size: 1.2rem; }
    .about-vm__text { color: var(--body-text); line-height: 1.65; margin: 0; }

    /* Core values */
    .about-value {
        height: 100%; background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.25rem; text-align: center;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .about-value:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: var(--accent); }
    .about-value__icon {
        width: 54px; height: 54px; border-radius: 50%; margin: 0 auto .75rem;
        display: grid; place-items: center; font-size: 1.4rem;
        background: var(--accent-soft); color: var(--accent);
    }
    .about-value__title { font-weight: 700; color: var(--heading); font-size: .98rem; margin: 0 0 .3rem; }
    .about-value__text { font-size: .84rem; color: var(--muted); margin: 0; line-height: 1.5; }

    /* Language toggle (segmented) */
    .about-seg { display: inline-flex; background: var(--surface-alt); border: 1px solid var(--border); border-radius: 999px; padding: .25rem; }
    .about-seg .nav-link {
        border: 0; border-radius: 999px; font-weight: 700; font-size: .85rem; padding: .4rem 1.1rem;
        color: var(--muted); background: transparent;
    }
    .about-seg .nav-link.active { background: var(--accent); color: #fff; box-shadow: var(--shadow); }

    /* Timeline */
    .about-timeline { position: relative; margin: 0; padding: 0 0 0 1.75rem; list-style: none; }
    .about-timeline::before { content: ""; position: absolute; left: 6px; top: .35rem; bottom: .35rem; width: 2px; background: var(--border); }
    .about-tl-item { position: relative; padding-bottom: 1.6rem; }
    .about-tl-item:last-child { padding-bottom: 0; }
    .about-tl-item::before {
        content: ""; position: absolute; left: -1.75rem; top: .3rem; width: 14px; height: 14px;
        border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft);
    }
    .about-tl-badge { display: inline-block; font-size: .72rem; font-weight: 800; letter-spacing: .04em; color: var(--accent); text-transform: uppercase; }
    .about-tl-title { font-weight: 700; color: var(--heading); margin: .1rem 0 .35rem; font-size: 1.02rem; }
    .about-tl-text { color: var(--body-text); line-height: 1.65; margin: 0; font-size: .95rem; }

    /* Logo aside */
    .about-seal { background: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; text-align: center; position: sticky; top: 1rem; }
    .about-seal img { max-height: 170px; width: auto; object-fit: contain; transition: transform .3s ease; }
    .about-seal:hover img { transform: scale(1.05) rotate(-2deg); }
    .about-seal__badge { display: inline-block; background: var(--brand); color: #fff; border-radius: 999px; padding: .35rem .85rem; font-size: .78rem; font-weight: 600; }

    /* Contact cards */
    .about-contact {
        display: flex; align-items: flex-start; gap: .9rem; height: 100%;
        background: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 1.15rem; text-decoration: none;
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .about-contact:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .about-contact__icon { flex: 0 0 auto; width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; font-size: 1.3rem; }
    .about-contact__label { font-size: .78rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; font-weight: 700; }
    .about-contact__value { color: var(--heading); font-weight: 700; margin: .15rem 0 0; }

    /* Barangay Officials — profile (left) + personal history (right) */
    .official-block {
        display: grid; grid-template-columns: 300px 1fr; gap: 0;
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
        box-shadow: var(--shadow); overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .official-block:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }

    /* LEFT — current profile */
    .official-block__profile {
        text-align: center; padding: 1.75rem 1.25rem;
        background: var(--surface-alt); border-right: 1px solid var(--border);
        display: flex; flex-direction: column; align-items: center;
    }
    .official-block__profile--lead { box-shadow: inset 4px 0 0 0 var(--accent); }
    .official-photo {
        width: 108px; height: 108px; border-radius: 50%; overflow: hidden;
        display: grid; place-items: center; margin-bottom: 1rem;
        background: var(--accent-soft); color: var(--accent);
        border: 4px solid var(--surface); box-shadow: 0 0 0 1px var(--border);
    }
    .official-photo img { width: 100%; height: 100%; object-fit: cover; }
    .official-photo__initials { font-weight: 800; font-size: 2.1rem; }
    .official-name { font-weight: 800; color: var(--heading); font-size: 1.12rem; margin: 0 0 .5rem; }
    .official-pos {
        display: inline-block; font-size: .78rem; font-weight: 700; letter-spacing: .02em;
        padding: .3rem .8rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent);
    }
    .official-committee { margin-top: .6rem; font-size: .84rem; color: var(--muted); }
    .official-committee i { color: var(--accent); }
    .official-status {
        margin-top: .8rem; display: inline-flex; align-items: center; gap: .4rem;
        font-size: .78rem; font-weight: 700; padding: .28rem .7rem; border-radius: 999px;
    }
    .official-status.is-active { background: rgba(22,163,74,.14); color: #16a34a; }
    .official-status.is-inactive { background: rgba(148,163,184,.18); color: var(--muted); }
    .official-status__dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
    .official-sig { margin-top: 1rem; padding-top: .85rem; border-top: 1px dashed var(--border); width: 100%; }
    .official-sig__label { display: block; font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; font-weight: 700; color: var(--muted); margin-bottom: .3rem; }
    .official-sig img { max-height: 48px; width: auto; object-fit: contain; }

    /* RIGHT — personal official history (timeline) */
    .official-block__history { padding: 1.75rem 1.6rem; }
    .official-history__title { font-weight: 800; color: var(--heading); font-size: 1.02rem; margin: 0 0 1.15rem; display: flex; align-items: center; }
    .official-history__title i { color: var(--accent); }
    .official-timeline { list-style: none; margin: 0; padding: 0 0 0 1.5rem; position: relative; }
    .official-timeline::before { content: ""; position: absolute; left: 5px; top: .4rem; bottom: .4rem; width: 2px; background: var(--border); }
    .official-timeline__item { position: relative; padding-bottom: 1.35rem; }
    .official-timeline__item:last-child { padding-bottom: 0; }
    .official-timeline__item::before {
        content: ""; position: absolute; left: -1.5rem; top: .25rem; width: 12px; height: 12px;
        border-radius: 50%; background: var(--surface); border: 2px solid var(--border);
    }
    .official-timeline__item.is-current::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
    .official-timeline__range { font-weight: 800; color: var(--heading); font-size: .92rem; display: flex; align-items: center; gap: .5rem; }
    .official-timeline__badge { font-size: .64rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: #fff; background: var(--accent); border-radius: 999px; padding: .12rem .5rem; }
    .official-timeline__pos { color: var(--body-text); font-weight: 600; font-size: .9rem; margin-top: .15rem; }
    .official-timeline__committee { color: var(--muted); font-size: .82rem; margin-top: .1rem; }

    @@media (max-width: 767.98px) {
        .official-block { grid-template-columns: 1fr; }
        .official-block__profile { border-right: 0; border-bottom: 1px solid var(--border); }
    }

    .about-empty {
        background: var(--surface-alt); border: 1px dashed var(--border); border-radius: var(--radius);
        padding: 2.25rem 1.25rem; text-align: center; color: var(--muted);
    }
    .about-empty i { font-size: 2rem; opacity: .55; display: block; margin-bottom: .5rem; }

    /* Scroll reveal */
    .reveal { opacity: 0; transform: translateY(18px); transition: opacity .55s ease, transform .55s ease; }
    .reveal.is-in { opacity: 1; transform: none; }

    @@media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1 !important; transform: none !important; transition: none; }
        .about-stat:hover, .about-vm:hover, .about-value:hover, .about-contact:hover, .about-chip:hover { transform: none; }
        .about-seal:hover img { transform: none; }
    }
</style>

<!-- 🎠 HERO -->
<section class="about-hero">
    <div class="about-hero__inner">
        <span class="about-hero__eyebrow"><i class="bi bi-geo-alt-fill"></i> District IV · Quezon City</span>
        <h1 class="about-hero__title">About Our Barangay</h1>
        <p class="about-hero__sub">Learn about our history, organizational goals, core public values, and community structures in Barangay Tatalon.</p>
        <div class="about-hero__chips">
            <a href="#vision" class="about-chip"><i class="bi bi-compass"></i> Vision &amp; Mission</a>
            <a href="#values" class="about-chip"><i class="bi bi-award"></i> Core Values</a>
            <a href="#history" class="about-chip"><i class="bi bi-clock-history"></i> History</a>
            <a href="#contact" class="about-chip"><i class="bi bi-headset"></i> Contact</a>
        </div>
    </div>
</section>

<div class="container about-wrap pb-5">

    <!-- ⚡ QUICK FACTS -->
    <div class="row g-3 about-stats">
        <div class="col-6 col-lg-3 reveal">
            <div class="about-stat">
                <div class="about-stat__icon"><i class="bi bi-flag-fill"></i></div>
                <div>
                    <div class="about-stat__value">Est. 1939</div>
                    <div class="about-stat__label">Commonwealth Act No. 502</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal">
            <div class="about-stat">
                <div class="about-stat__icon"><i class="bi bi-house-heart-fill"></i></div>
                <div>
                    <div class="about-stat__value">R.A. 2616</div>
                    <div class="about-stat__label">Land reform · 1959</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal">
            <div class="about-stat">
                <div class="about-stat__icon"><i class="bi bi-geo-fill"></i></div>
                <div>
                    <div class="about-stat__value">District IV</div>
                    <div class="about-stat__label">Quezon City</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal">
            <div class="about-stat">
                <div class="about-stat__icon"><i class="bi bi-clock-fill"></i></div>
                <div>
                    <div class="about-stat__value">Mon–Fri</div>
                    <div class="about-stat__label">8:00 AM – 5:00 PM</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 👁️ VISION & MISSION -->
    <div class="text-center mt-5 mb-4 reveal" id="vision">
        <span class="about-eyebrow">What drives us</span>
        <h2 class="about-h2">Vision &amp; Mission</h2>
    </div>
    <div class="row g-4">
        <div class="col-md-6 reveal">
            <div class="about-card about-vm about-vm--vision">
                <div class="about-vm__icon"><i class="bi bi-eye-fill"></i></div>
                <h3 class="about-vm__title">Our Vision (Pananaw)</h3>
                <p class="about-vm__text">
                    To build a safe, progressive, climate-resilient, and united Barangay Tatalon that promotes sustainable economic development, equal public healthcare opportunities, and innovative community infrastructure frameworks driven by digitalized data automation systems.
                </p>
            </div>
        </div>
        <div class="col-md-6 reveal">
            <div class="about-card about-vm about-vm--mission">
                <div class="about-vm__icon"><i class="bi bi-flag-fill"></i></div>
                <h3 class="about-vm__title">Our Mission (Layunin)</h3>
                <p class="about-vm__text">
                    To deliver accessible and accurate public welfare services, transparent budget administration reporting, swift disaster risk management reactions, and strong legal support platforms for the common good of all registered families within our territory.
                </p>
            </div>
        </div>
    </div>

    <!-- 🏅 CORE VALUES (drawn from our mission) -->
    <div class="text-center mt-5 mb-4 reveal" id="values">
        <span class="about-eyebrow">How we serve</span>
        <h2 class="about-h2">Core Public Values</h2>
    </div>
    <div class="row g-3">
        <div class="col-6 col-lg-3 reveal">
            <div class="about-value">
                <div class="about-value__icon"><i class="bi bi-people-fill"></i></div>
                <h4 class="about-value__title">Accessible Services</h4>
                <p class="about-value__text">Public welfare and frontline desk services within reach of every resident.</p>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal">
            <div class="about-value">
                <div class="about-value__icon"><i class="bi bi-clipboard2-data-fill"></i></div>
                <h4 class="about-value__title">Transparency</h4>
                <p class="about-value__text">Open and accurate budget administration and public reporting.</p>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal">
            <div class="about-value">
                <div class="about-value__icon"><i class="bi bi-shield-fill-check"></i></div>
                <h4 class="about-value__title">Disaster Resilience</h4>
                <p class="about-value__text">Swift, prepared, and coordinated disaster risk management responses.</p>
            </div>
        </div>
        <div class="col-6 col-lg-3 reveal">
            <div class="about-value">
                <div class="about-value__icon"><i class="bi bi-scales"></i></div>
                <h4 class="about-value__title">Legal Support</h4>
                <p class="about-value__text">Strong mediation and legal support platforms for every family.</p>
            </div>
        </div>
    </div>

    <!-- 🏛️ LIST OF BARANGAY OFFICIALS (dynamic, database-driven) -->
    <div class="text-center mt-5 mb-4 reveal" id="officials">
        <span class="about-eyebrow">Pamunuan</span>
        <h2 class="about-h2">List of Barangay Officials</h2>
        <p class="mb-0" style="color: var(--muted);">Ang kasalukuyang nakaupong opisyal ng Barangay Tatalon.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var official in Model)
            {
                var isLead = (official.Position ?? "").ToLower().Contains("captain") || (official.Position ?? "").ToLower().Contains("punong");

                // Ang history na ito ay pag-aari LAMANG ng taong ito (via BarangayOfficialId).
                // I-order mula pinakabago → pinakaluma. Kung walang record, gumawa ng
                // derived na kasalukuyang termino mula sa profile para hindi walang laman.
                var terms = official.ServiceHistories
                    .OrderByDescending(h => h.StartDate)
                    .ToList();

                <div class="official-block reveal">
                    <!-- LEFT: CURRENT PROFILE -->
                    <div class="official-block__profile @(isLead ? "official-block__profile--lead" : "")">
                        <div class="official-photo">
                            @if (!string.IsNullOrWhiteSpace(official.ProfileImagePath))
                            {
                                <img src="~/uploads/officials/@official.ProfileImagePath" alt="Larawan ni @official.FullName" loading="lazy" />
                            }
                            else
                            {
                                <span class="official-photo__initials">@Initials(official.FullName)</span>
                            }
                        </div>
                        <h3 class="official-name">@official.FullName</h3>
                        <span class="official-pos">@official.Position</span>
                        @if (!string.IsNullOrWhiteSpace(official.Committee))
                        {
                            <div class="official-committee"><i class="bi bi-diagram-3-fill me-1"></i>@official.Committee</div>
                        }
                        <div class="official-status @(official.IsActive ? "is-active" : "is-inactive")">
                            <span class="official-status__dot"></span>@(official.IsActive ? "Active in Service" : "Inactive")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(official.SignaturePath))
                        {
                            <div class="official-sig">
                                <span class="official-sig__label">E-Signature</span>
                                <img src="~/uploads/signatures/@official.SignaturePath" alt="Lagda ni @official.FullName" loading="lazy" />
                            </div>
                        }
                    </div>

                    <!-- RIGHT: THIS PERSON'S OWN OFFICIAL HISTORY -->
                    <div class="official-block__history">
                        <h4 class="official-history__title"><i class="bi bi-clock-history me-2"></i>Official History of @official.FullName</h4>

                        @if (terms.Any())
                        {
                            <ul class="official-timeline">
                                @foreach (var term in terms)
                                {
                                    var range = term.StartDate.Year.ToString() + " – " + (term.EndDate.HasValue ? term.EndDate.Value.Year.ToString() : "Present");
                                    var isCurrent = term.EndDate == null || string.Equals(term.Status, "Current", StringComparison.OrdinalIgnoreCase);
                                    <li class="official-timeline__item @(isCurrent ? "is-current" : "")">
                                        <div class="official-timeline__range">
                                            @range
                                            @if (isCurrent)
                                            {
                                                <span class="official-timeline__badge">Current</span>
                                            }
                                        </div>
                                        <div class="official-timeline__pos">@term.Position</div>
                                        @if (!string.IsNullOrWhiteSpace(term.Committee))
                                        {
                                            <div class="official-timeline__committee">@term.Committee</div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <!-- Walang naka-record na history — ipakita ang kasalukuyang termino mula sa profile. -->
                            <ul class="official-timeline">
                                <li class="official-timeline__item is-current">
                                    <div class="official-timeline__range">Present <span class="official-timeline__badge">Current</span></div>
                                    <div class="official-timeline__pos">@official.Position</div>
                                    @if (!string.IsNullOrWhiteSpace(official.Committee))
                                    {
                                        <div class="official-timeline__committee">@official.Committee</div>
                                    }
                                </li>
                            </ul>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="about-empty reveal">
            <i class="bi bi-people"></i>
            Wala pang nakalistang aktibong opisyal sa kasalukuyan.
        </div>
    }

    <!-- 📜 HISTORICAL BACKGROUND -->
    <div class="about-card mt-5 reveal" id="history">
        <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4 flex-wrap gap-3" style="border-color: var(--border) !important;">
            <div>
