                <p class="mb-0" style="color: var(--muted);">Foundation, Territorial Roots, and the Tatalon Estate Land Reform</p>
            </div>
            <ul class="nav about-seg" id="historyTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="english-tab" data-bs-toggle="tab" data-bs-target="#english-history" type="button" role="tab">English</button>
