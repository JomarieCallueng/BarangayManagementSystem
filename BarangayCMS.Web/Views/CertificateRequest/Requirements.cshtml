@{
    ViewData["Title"] = "Document Requirements";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Public site layout (not the Admin portal)
}

<style>
    /* ===== Public form pages (theme-aware) — same shell as "File a Report" ===== */
    .pubform { max-width: 920px; }
    .pubform__card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); box-shadow: var(--shadow-lg); overflow: hidden;
    }
    .pubform__head {
        background: var(--hero-bg); color: var(--hero-text);
        padding: 1.5rem 1.75rem; display: flex; align-items: center; gap: 1rem;
    }
    .pubform__head-icon {
        flex: 0 0 auto; width: 54px; height: 54px; border-radius: 14px; display: grid; place-items: center;
        font-size: 1.55rem; color: #fff; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.24);
    }
    .pubform__head h1 { font-size: 1.3rem; font-weight: 800; margin: 0; color: #fff; }
    .pubform__head p { margin: .15rem 0 0; font-size: .85rem; color: rgba(255,255,255,.75); }
    .pubform__body { padding: 1.75rem; }
    @@media (min-width: 768px) { .pubform__body { padding: 2.25rem; } }
    .pubform__note {
        background: var(--accent-soft); border: 1px solid var(--border); border-radius: var(--radius);
        padding: .8rem 1rem; font-size: .85rem; color: var(--body-text); margin-bottom: 1.5rem;
    }
    .pubform__note i { color: var(--accent); }
    .pubform__actions {
        display: flex; justify-content: center; gap: .6rem; flex-wrap: wrap;
        border-top: 1px solid var(--border); padding-top: 1.5rem; margin-top: 1.75rem;
    }

    /* Document block inside the card body */
    .req-doc {
        position: relative; height: 100%; overflow: hidden;
        background: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 1.35rem;
    }
    .req-doc::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; }
    .req-doc--clearance::before { background: var(--brand-soft); }
    .req-doc--indigency::before { background: #dc3545; }
    .req-doc__head { display: flex; align-items: center; gap: .7rem; margin-bottom: .5rem; }
    .req-doc__icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-size: 1.3rem; }
    .req-doc--clearance .req-doc__icon { background: rgba(30,58,138,.12); color: var(--brand-soft); }
    .req-doc--indigency .req-doc__icon { background: rgba(220,53,69,.12); color: #dc3545; }
    .req-doc__title { font-weight: 800; color: var(--heading); font-size: 1.1rem; margin: 0; }
    .req-doc__desc { color: var(--muted); font-size: .86rem; margin: 0 0 .9rem; }
    .req-list { list-style: none; margin: 0; padding: 0; }
    .req-list li { display: flex; align-items: flex-start; gap: .55rem; padding: .5rem 0; color: var(--body-text); font-size: .9rem; line-height: 1.5; }
    .req-list li + li { border-top: 1px dashed var(--border); }
    .req-list i { color: var(--accent); font-size: 1.05rem; flex: 0 0 auto; margin-top: .05rem; }

    .btn-brand { background: var(--accent); border: 1px solid var(--accent); color: #fff; font-weight: 700; }
    .btn-brand:hover, .btn-brand:focus { background: var(--accent-hover); border-color: var(--accent-hover); color: #fff; }
    .btn-brand i { transition: transform .18s ease; }
    .btn-brand:hover i { transform: translateX(4px); }
</style>

<div class="container my-5 pubform">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Document Requirements</li>
        </ol>
    </nav>

    <div class="pubform__card">
        <div class="pubform__head">
            <div class="pubform__head-icon"><i class="bi bi-file-earmark-check"></i></div>
            <div>
                <h1>Document Requirements</h1>
                <p>Check the necessary documentation before filing your applications online or claiming them at the windows.</p>
            </div>
        </div>

        <div class="pubform__body">
            <div class="pubform__note">
                <i class="bi bi-info-circle-fill me-1"></i>
                Ihanda ang mga kinakailangang dokumento sa ibaba bago magpatuloy sa online request form para mas mabilis ang pagproseso.
            </div>

            <div class="row g-4">
                <!-- Barangay Clearance -->
                <div class="col-md-6">
                    <div class="req-doc req-doc--clearance">
                        <div class="req-doc__head">
                            <div class="req-doc__icon"><i class="bi bi-person-badge-fill"></i></div>
                            <h2 class="req-doc__title">Barangay Clearance</h2>
                        </div>
                        <p class="req-doc__desc">Issued for employment, local identification, or bank account openings.</p>
                        <ul class="req-list">
                            <li><i class="bi bi-check-circle-fill"></i> Recent Community Tax Certificate (Cedula)</li>
                            <li><i class="bi bi-check-circle-fill"></i> Any valid government-issued ID (with photo)</li>
                            <li><i class="bi bi-check-circle-fill"></i> Fully completed digital or physical form</li>
                        </ul>
                    </div>
                </div>

                <!-- Certificate of Indigency -->
                <div class="col-md-6">
                    <div class="req-doc req-doc--indigency">
                        <div class="req-doc__head">
                            <div class="req-doc__icon"><i class="bi bi-heart-pulse-fill"></i></div>
                            <h2 class="req-doc__title">Certificate of Indigency</h2>
                        </div>
                        <p class="req-doc__desc">Issued to low-income residents for medical, educational, or financial aid.</p>
                        <ul class="req-list">
                            <li><i class="bi bi-check-circle-fill"></i> Case study report from DSWD or proof of low income</li>
                            <li><i class="bi bi-check-circle-fill"></i> Voter registration validation or Brgy. ID</li>
                            <li><i class="bi bi-check-circle-fill"></i> Purpose specifications (e.g., hospital bill, school billing)</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="pubform__actions">
                <a asp-action="Create" class="btn btn-brand px-4 py-2 rounded-3 shadow-sm">
                    Proceed to Online Request Form <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
