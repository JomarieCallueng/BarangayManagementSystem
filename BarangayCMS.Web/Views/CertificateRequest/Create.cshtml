@model BarangayCMS.Web.Areas.Admin.Models.CertificateViewModel

@{
    ViewData["Title"] = "Online Request Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ===== Public form pages (theme-aware) — shared look for Complaint & Certificate ===== */
    .pubform { max-width: 820px; }
    .pubform__card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); box-shadow: var(--shadow-lg); overflow: hidden;
    }
    .pubform__head {
        background: var(--hero-bg); color: var(--hero-text);
        padding: 1.5rem 1.75rem; display: flex; align-items: center; gap: 1rem;
    }
    .pubform__head-icon {
        flex: 0 0 auto; width: 54px; height: 54px; border-radius: 14px; display: grid; place-items: center;
        font-size: 1.55rem; color: #fff; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.24);
    }
    .pubform__head h1 { font-size: 1.3rem; font-weight: 800; margin: 0; color: #fff; }
    .pubform__head p { margin: .15rem 0 0; font-size: .85rem; color: rgba(255,255,255,.75); }
    .pubform__body { padding: 1.75rem; }
    @@media (min-width: 768px) { .pubform__body { padding: 2.25rem; } }
    .pubform__section {
        font-weight: 700; color: var(--heading); font-size: 1rem;
        display: flex; align-items: center; gap: .5rem;
        border-bottom: 1px solid var(--border); padding-bottom: .55rem; margin-bottom: 1.1rem;
    }
    .pubform__section i { color: var(--accent); }
    .pubform .form-label { font-weight: 600; font-size: .82rem; color: var(--body-text); }
    .pubform .form-control, .pubform .form-select { border-radius: 10px; padding-top: .6rem; padding-bottom: .6rem; }
    .pubform .form-control:focus, .pubform .form-select:focus {
        border-color: var(--accent); box-shadow: 0 0 0 .2rem var(--accent-soft);
    }
    .pubform__actions {
        display: flex; justify-content: flex-end; gap: .6rem; flex-wrap: wrap;
        border-top: 1px solid var(--border); padding-top: 1.25rem; margin-top: .5rem;
    }
    .pubform__note {
        background: var(--accent-soft); border: 1px solid var(--border); border-radius: var(--radius);
        padding: .8rem 1rem; font-size: .85rem; color: var(--body-text); margin-bottom: 1.5rem;
    }
    .pubform__note i { color: var(--accent); }
    /* Payment sub-panels */
    .pubform__pay {
        background: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 1rem; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    }
    .pubform__price {
        background: var(--surface-alt); border: 2px dashed var(--border); border-radius: var(--radius);
        padding: 1rem; text-align: center; margin-bottom: 1rem;
    }
    .btn-brand { background: var(--accent); border: 1px solid var(--accent); color: #fff; font-weight: 600; }
    .btn-brand:hover, .btn-brand:focus { background: var(--accent-hover); border-color: var(--accent-hover); color: #fff; }
</style>

<div class="container my-5 pubform">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Request Certificate</li>
        </ol>
    </nav>

    <div class="pubform__card">
        <div class="pubform__head">
            <div class="pubform__head-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
            <div>
                <h1>Online Certificate Request Form</h1>
                <p>Humiling ng opisyal na dokumento ng barangay nang ligtas at mabilis.</p>
            </div>
        </div>

        <div class="pubform__body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-3 small mb-4">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <div class="pubform__note">
                <i class="bi bi-info-circle-fill me-1"></i>
                <strong>Paalala:</strong> Siguraduhing totoo at kumpleto ang impormasyong inyong ilalagay upang mabilis na maproseso ang inyong hiling.
            </div>

            <form asp-controller="CertificateRequest" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- Certificate Details Section -->
                <div class="pubform__section"><i class="bi bi-file-earmark-text-fill"></i> Certificate Details</div>
                <div class="row g-3 mb-4">
                    <!-- Certificate Type Dropdown -->
                    <div class="col-12">
                        <label class="form-label">Uri ng Sertipiko / Certificate Type <span class="text-danger">*</span></label>
                        <select class="form-select form-select-lg" id="certificateSelect" asp-for="CertificateType" required>
                            <option value="" data-price="0" disabled selected>-- Piliin ang dokumentong kailangan --</option>
                            @if (ViewBag.CertificateTypes != null)
                            {
                                foreach (var type in (IEnumerable<dynamic>)ViewBag.CertificateTypes)
                                {
                                    <option value="@type.CertificateName" data-price="@type.Price">
                                        @type.CertificateName (₱@type.Price.ToString("F2"))
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CertificateType" class="text-danger small"></span>
                    </div>

                    <!-- Dynamic Requirements (DB-driven) -->
                    <div class="col-12">
                        <partial name="_CertificateRequirements"
                                 view-data='@(new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) {
                                     { "SelectSelector", "#certificateSelect" },
                                     { "By", "name" } })' />
                    </div>

                    <!-- Applicant Name -->
                    <div class="col-12">
                        <label class="form-label">Buong Pangalan ng Residente (Full Name) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="ResidentFullName" placeholder="Halimbawa: Juan Dela Cruz" required />
                        <span asp-validation-for="ResidentFullName" class="text-danger small"></span>
                    </div>

                    <!-- Purpose -->
                    <div class="col-12">
                        <label class="form-label">Dahilan ng Pagkuha (Purpose of Request) <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" asp-for="Purpose" placeholder="Halimbawa: Employment, Local ID Requirement, Financial Aid..." required></textarea>
                        <span asp-validation-for="Purpose" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Payment Section -->
                <div class="pubform__section"><i class="bi bi-wallet2"></i> Payment Information</div>
                <div class="mb-4" id="paymentSectionCard">
                    <div class="row g-3 align-items-stretch">

                        <!-- 💳 GCash Details -->
                        <div class="col-md-5" id="gcashQrArea">
                            <div class="pubform__pay">
                                <span class="badge bg-primary px-3 py-2 rounded-pill mb-2 fw-semibold" style="font-size: 0.75rem;">
                                    GCash Payment
                                </span>
                                <div class="p-2 bg-white rounded-3 shadow-sm my-1 d-inline-block border">
                                    <img src="/images/gcash-qr-sample.png" alt="Barangay GCash QR" class="img-fluid d-block mx-auto" style="max-width: 160px; height: auto;" />
                                </div>
                                <div class="mt-2">
                                    <div class="small fw-bold text-uppercase" style="letter-spacing: 0.5px; color: var(--heading);">BARANGAY TATALON</div>
                                    <div class="small text-muted fw-medium">0992-927-9250</div>
                                </div>
                            </div>
                        </div>

                        <!-- Dynamic Price & Upload -->
                        <div class="col-md-7">
                            <div class="pubform__price" id="priceDisplayBox">
                                <span class="text-muted d-block small fw-semibold">HALAGA NG BABAYARAN (AMOUNT TO PAY)</span>
                                <span class="fs-2 fw-bold text-primary" id="amountToPay">₱0.00</span>
                            </div>

                            <div class="form-group" id="receiptUploadGroup">
                                <label class="form-label" id="uploadLabel">I-upload ang Resibo / Screenshot ng GCash</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-cloud-upload text-primary"></i></span>
                                    <input type="file" class="form-control" name="PaymentReceipt" id="paymentReceiptInput" accept="image/*" required />
                                </div>
                                <div class="form-text text-muted small">Tanging mga imahe lamang (.png, .jpg, .jpeg) ang pinapayagan.</div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Buttons -->
                <div class="pubform__actions">
                    <a href="/" class="btn btn-light border px-4 fw-semibold rounded-3">Bumalik / Cancel</a>
                    <button type="submit" class="btn btn-brand px-4 rounded-3 shadow-sm">
                        <i class="bi bi-send-fill me-2"></i>I-submit ang Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/certificate-requirements.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const certSelect = document.getElementById("certificateSelect");
            const amountText = document.getElementById("amountToPay");
            const priceBox = document.getElementById("priceDisplayBox");
            const receiptInput = document.getElementById("paymentReceiptInput");
            const gcashArea = document.getElementById("gcashQrArea");
            const receiptGroup = document.getElementById("receiptUploadGroup");

            certSelect.addEventListener("change", function () {
                const selectedOption = certSelect.options[certSelect.selectedIndex];
                const price = parseFloat(selectedOption.getAttribute("data-price")) || 0;

                if (price === 0) {
                    amountText.innerText = "LIBRE (₱0.00)";
                    amountText.className = "fs-2 fw-bold text-success";
                    priceBox.style.borderColor = "#28a745";

                    receiptInput.removeAttribute("required");
                    receiptInput.value = "";
                    receiptGroup.style.display = "none";
                    gcashArea.style.display = "none";
                } else {
                    amountText.innerText = "₱" + price.toFixed(2);
                    amountText.className = "fs-2 fw-bold text-primary";
                    priceBox.style.borderColor = "";

                    receiptInput.setAttribute("required", "required");
                    receiptGroup.style.display = "block";
                    gcashArea.style.display = "block";
                }
            });
        });
    </script>
}
