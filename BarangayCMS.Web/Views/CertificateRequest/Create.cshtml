@model BarangayCMS.Web.Areas.Admin.Models.CertificateViewModel

@{
    ViewData["Title"] = "Online Request Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Request Certificate</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header text-white p-4 rounded-top-4" style="background-color: #122240;">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-file-earmark-text-fill text-warning fs-3"></i>
                        <div>
                            <h4 class="m-0 fw-bold">Online Certificate Request Form</h4>
                            <small class="text-white-50">Humiling ng opisyal na dokumento ng barangay nang ligtas at mabilis.</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 rounded-3 small mb-4">
                            <div asp-validation-summary="All" class="text-danger"></div>
                        </div>
                    }

                    <div class="alert alert-info border-0 rounded-3 small mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Paalala:</strong> Siguraduhing totoo at kumpleto ang impormasyong inyong ilalagay upang mabilis na maproseso ang inyong hiling.
                    </div>

                    <form asp-controller="CertificateRequest" asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <!-- Certificate Details Section -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-file-earmark-text-fill text-muted me-2"></i>Certificate Details</h5>
                        <div class="row g-3 mb-4">
                            <!-- Certificate Type Dropdown -->
                            <div class="col-12">
                                <label class="form-label fw-semibold small text-muted">Uri ng Sertipiko / Certificate Type <span class="text-danger">*</span></label>
                                <select class="form-select form-select-lg py-2 rounded-3" id="certificateSelect" asp-for="CertificateType" required>
                                    <option value="" data-price="0" disabled selected>-- Piliin ang dokumentong kailangan --</option>

                                    @if (ViewBag.CertificateTypes != null)
                                    {
                                        foreach (var type in (IEnumerable<dynamic>)ViewBag.CertificateTypes)
                                        {
                                            <option value="@type.CertificateName" data-price="@type.Price">
                                                @type.CertificateName (₱@type.Price.ToString("F2"))
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CertificateType" class="text-danger small"></span>
                            </div>

                            <!-- Dynamic Requirements (DB-driven) -->
                            <div class="col-12">
                                <partial name="_CertificateRequirements"
                                         view-data='@(new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) {
                                             { "SelectSelector", "#certificateSelect" },
                                             { "By", "name" } })' />
                            </div>

                            <!-- Applicant Name -->
                            <div class="col-12">
                                <label class="form-label fw-semibold small text-muted">Buong Pangalan ng Residente (Full Name) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control py-2 rounded-3" asp-for="ResidentFullName" placeholder="Halimbawa: Juan Dela Cruz" required />
                                <span asp-validation-for="ResidentFullName" class="text-danger small"></span>
                            </div>

                            <!-- Purpose -->
                            <div class="col-12">
                                <label class="form-label fw-semibold small text-muted">Dahilan ng Pagkuha (Purpose of Request) <span class="text-danger">*</span></label>
                                <textarea class="form-control rounded-3" rows="3" asp-for="Purpose" placeholder="Halimbawa: Employment, Local ID Requirement, Financial Aid..." required></textarea>
                                <span asp-validation-for="Purpose" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Payment Section -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-wallet2 text-muted me-2"></i>Payment Information</h5>
                        <div class="mb-4" id="paymentSectionCard">
                            <div class="row g-3 align-items-center">
                                <!-- GCash Details -->
                                <div class="col-md-5 text-center" id="gcashQrArea">
                                    <div class="bg-light p-3 rounded-3 border">
                                        <span class="badge bg-primary px-3 py-1 mb-2">GCash Payment</span>
                                        <img src="/images/gcash-qr-sample.png" alt="Barangay GCash QR" class="img-fluid rounded-2 mb-2" style="max-height: 150px;" />
                                        <div class="small fw-bold text-dark">BARANGAY TATALON</div>
                                        <div class="small text-muted">0912-345-6789</div>
                                    </div>
                                </div>

                                <!-- Dynamic Price & Upload -->
                                <div class="col-md-7">
                                    <div class="p-3 mb-3 rounded-3 text-center" id="priceDisplayBox" style="background-color: #f8f9fa; border: 2px dashed #dee2e6;">
                                        <span class="text-muted d-block small fw-semibold">HALAGA NG BABAYARAN (AMOUNT TO PAY)</span>
                                        <span class="fs-2 fw-bold text-primary" id="amountToPay">₱0.00</span>
                                    </div>

                                    <div class="form-group" id="receiptUploadGroup">
                                        <label class="form-label fw-semibold small text-muted" id="uploadLabel">I-upload ang Resibo / Screenshot ng GCash</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-cloud-upload text-primary"></i></span>
                                            <input type="file" class="form-control py-2" name="PaymentReceipt" id="paymentReceiptInput" accept="image/*" required />
                                        </div>
                                        <div class="form-text text-muted small">Tanging mga imahe lamang (.png, .jpg, .jpeg) ang pinapayagan.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2 border-top pt-4">
                            <a href="/" class="btn btn-light px-4 py-2 fw-semibold rounded-3 border">Bumalik / Cancel</a>
                            <button type="submit" class="btn px-4 py-2 fw-semibold text-white rounded-3 shadow-sm" style="background-color: #12305B; border-color: #12305B;">
                                <i class="bi bi-send-fill me-2"></i>I-submit ang Request
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/certificate-requirements.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const certSelect = document.getElementById("certificateSelect");
            const amountText = document.getElementById("amountToPay");
            const priceBox = document.getElementById("priceDisplayBox");
            const receiptInput = document.getElementById("paymentReceiptInput");
            const gcashArea = document.getElementById("gcashQrArea");
            const receiptGroup = document.getElementById("receiptUploadGroup");

            certSelect.addEventListener("change", function () {
                const selectedOption = certSelect.options[certSelect.selectedIndex];
                const price = parseFloat(selectedOption.getAttribute("data-price")) || 0;

                if (price === 0) {
                    amountText.innerText = "LIBRE (₱0.00)";
                    amountText.className = "fs-2 fw-bold text-success";
                    priceBox.style.borderColor = "#28a745";
                    priceBox.style.backgroundColor = "#e8f5e9";

                    receiptInput.removeAttribute("required");
                    receiptInput.value = "";
                    receiptGroup.style.display = "none";
                    gcashArea.style.display = "none";
                } else {
                    amountText.innerText = "₱" + price.toFixed(2);
                    amountText.className = "fs-2 fw-bold text-primary";
                    priceBox.style.borderColor = "#0d6efd";
                    priceBox.style.backgroundColor = "#f8f9fa";

                    receiptInput.setAttribute("required", "required");
                    receiptGroup.style.display = "block";
                    gcashArea.style.display = "block";
                }
            });
        });
    </script>
}