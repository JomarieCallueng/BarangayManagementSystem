@{
    ViewData["Title"] = "File a Complaint - Barangay Management System";
}

<style>
    /* ===== Public form pages (theme-aware) — shared look for Complaint & Certificate ===== */
    .pubform { max-width: 820px; }
    .pubform__card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); box-shadow: var(--shadow-lg); overflow: hidden;
    }
    .pubform__head {
        background: var(--hero-bg); color: var(--hero-text);
        padding: 1.5rem 1.75rem; display: flex; align-items: center; gap: 1rem;
    }
    .pubform__head-icon {
        flex: 0 0 auto; width: 54px; height: 54px; border-radius: 14px; display: grid; place-items: center;
        font-size: 1.55rem; color: #fff; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.24);
    }
    .pubform__head h1 { font-size: 1.3rem; font-weight: 800; margin: 0; color: #fff; }
    .pubform__head p { margin: .15rem 0 0; font-size: .85rem; color: rgba(255,255,255,.75); }
    .pubform__body { padding: 1.75rem; }
    @@media (min-width: 768px) { .pubform__body { padding: 2.25rem; } }
    .pubform__section {
        font-weight: 700; color: var(--heading); font-size: 1rem;
        display: flex; align-items: center; gap: .5rem;
        border-bottom: 1px solid var(--border); padding-bottom: .55rem; margin-bottom: 1.1rem;
    }
    .pubform__section i { color: var(--accent); }
    .pubform .form-label { font-weight: 600; font-size: .82rem; color: var(--body-text); }
    .pubform .form-control, .pubform .form-select { border-radius: 10px; padding-top: .6rem; padding-bottom: .6rem; }
    .pubform .form-control:focus, .pubform .form-select:focus {
        border-color: var(--accent); box-shadow: 0 0 0 .2rem var(--accent-soft);
    }
    .pubform__actions {
        display: flex; justify-content: flex-end; gap: .6rem; flex-wrap: wrap;
        border-top: 1px solid var(--border); padding-top: 1.25rem; margin-top: .5rem;
    }
    .pubform__note {
        background: var(--accent-soft); border: 1px solid var(--border); border-radius: var(--radius);
        padding: .8rem 1rem; font-size: .85rem; color: var(--body-text); margin-bottom: 1.5rem;
    }
    .pubform__note i { color: var(--accent); }
    .btn-brand { background: var(--accent); border: 1px solid var(--accent); color: #fff; font-weight: 600; }
    .btn-brand:hover, .btn-brand:focus { background: var(--accent-hover); border-color: var(--accent-hover); color: #fff; }
</style>

<div class="container my-5 pubform">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">File a Complaint</li>
        </ol>
    </nav>

    <div class="pubform__card">
        <div class="pubform__head">
            <div class="pubform__head-icon"><i class="bi bi-chat-left-text-fill"></i></div>
            <div>
                <h1>Public Complaint &amp; Dispute Form</h1>
                <p>Isumite ang inyong hinaing o ulat nang ligtas at mabilis.</p>
            </div>
        </div>

        <div class="pubform__body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-3 small mb-4">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <div class="pubform__note">
                <i class="bi bi-info-circle-fill me-1"></i>
                <strong>Paalala:</strong> Siguraduhing totoo at kumpleto ang impormasyong inyong ilalagay upang mabilis na maaksyunan ng pamunuan ng barangay.
            </div>

            <form asp-controller="Complaint" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Seksyon 1: Impormasyon ng Nagrereklamo -->
                <div class="pubform__section"><i class="bi bi-person-fill"></i> Complainant Information</div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Buong Pangalan <span class="text-danger">*</span></label>
                        <input type="text" name="ComplainantName" class="form-control" placeholder="Juan Dela Cruz" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Numero ng Telepono / Mobile <span class="text-danger">*</span></label>
                        <input type="tel" name="ComplainantContact" class="form-control" placeholder="09123456789" required />
                    </div>
                </div>

                <!-- Seksyon 2: Detalye ng Reklamo -->
                <div class="pubform__section"><i class="bi bi-file-earmark-text-fill"></i> Incident Details</div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Petsa ng Pangyayari (Date of Incident) <span class="text-danger">*</span></label>
                        <input type="date" name="IncidentDate" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Lugar kung saan Nangyari (Location) <span class="text-danger">*</span></label>
                        <input type="text" name="IncidentLocation" class="form-control" placeholder="Saan eksaktong naganap ang insidente?" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Salaysay o Detalye ng Reklamo (Statement) <span class="text-danger">*</span></label>
                        <textarea name="Details" class="form-control" rows="5" placeholder="Ikuwento nang malinaw at detalyado ang buong pangyayari..." required></textarea>
                    </div>
                </div>

                <div class="pubform__actions">
                    <a href="/" class="btn btn-light border px-4 fw-semibold rounded-3">Cancel</a>
                    <button type="submit" class="btn btn-brand px-4 rounded-3 shadow-sm">
                        <i class="bi bi-send-fill me-2"></i>Isumite ang Reklamo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
