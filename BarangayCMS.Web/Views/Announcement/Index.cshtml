@model IEnumerable<BarangayCMS.Entities.Announcement>

@{
    ViewData["Title"] = "Mga Anunsyo sa Barangay";

    var items = Model?.ToList() ?? new List<BarangayCMS.Entities.Announcement>();
    var categories = items
        .Select(a => string.IsNullOrWhiteSpace(a.Category) ? "General" : a.Category.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => c)
        .ToList();
    var pinnedCount = items.Count(a => a.IsPinned);
    var latest = items.Any() ? items.Max(a => a.PublishDate) : (DateTime?)null;
}

@functions {
    string NormalizeCategory(string? c) => string.IsNullOrWhiteSpace(c) ? "General" : c.Trim();

    string BadgeClass(string? c)
    {
        var l = (c ?? "").ToLower();
        if (l.Contains("emergency") || l.Contains("alert")) return "badge-emergency";
        if (l.Contains("advisory") || l.Contains("warning")) return "badge-advisory";
        if (l.Contains("health") || l.Contains("center")) return "badge-health";
        if (l.Contains("holiday") || l.Contains("event")) return "badge-holiday";
        return "badge-general";
    }

    string RelativeTime(DateTime dt)
    {
        var span = DateTime.Now - dt;
        if (span.TotalSeconds < 0) return dt.ToString("MMM dd, yyyy");
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        if (span.TotalDays < 30) return $"{(int)(span.TotalDays / 7)}w ago";
        return dt.ToString("MMM dd, yyyy");
    }
}

<!-- Custom Styles para sa Hover Effects, Layout, at Badges -->
<style>
    .announcement-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border-radius: 16px !important;
        overflow: hidden;
    }

        .announcement-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }

    .hero-banner {
        background: linear-gradient(135deg, #0d233a 0%, #1a365d 100%);
        border-radius: 20px;
        color: white;
    }

    .badge-emergency { background-color: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; }
    .badge-advisory  { background-color: #fef3c7; color: #d97706; border: 1px solid #fcd34d; }
    .badge-health    { background-color: #dcfce7; color: #16a34a; border: 1px solid #86efac; }
    .badge-holiday   { background-color: #e0f2fe; color: #0284c7; border: 1px solid #7dd3fc; }
    .badge-general   { background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }

    /* Overview stat tiles */
    .ann-stat {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.1rem 1.25rem;
        height: 100%;
        display: flex;
        align-items: center;
        gap: .9rem;
    }
    .ann-stat__icon {
        width: 46px; height: 46px; flex: 0 0 auto;
        display: flex; align-items: center; justify-content: center;
        border-radius: 12px; font-size: 1.3rem;
    }
    .ann-stat__value { font-size: 1.5rem; font-weight: 700; line-height: 1.1; margin: 0; color: #0f172a; }
    .ann-stat__label { font-size: .78rem; color: #94a3b8; margin: 0; }

    /* Filter toolbar */
    .filter-chip {
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #475569;
        border-radius: 999px;
        padding: .4rem .95rem;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s ease;
        white-space: nowrap;
    }
        .filter-chip:hover { border-color: #1a365d; color: #1a365d; }
        .filter-chip.active { background: #1a365d; border-color: #1a365d; color: #fff; }
        .filter-chip .chip-count {
            display: inline-block;
            margin-left: .35rem;
            font-size: .7rem;
            opacity: .75;
        }

    /* Small meta chips inside cards */
    .meta-chip {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: .75rem; color: #64748b;
        background: #f8fafc; border: 1px solid #eef2f7;
        border-radius: 8px; padding: .2rem .5rem;
    }
</style>

<div class="container py-5">

    <!-- 🌟 MODERN HERO BANNER HEADER -->
    <div class="hero-banner p-4 p-md-5 mb-4 shadow-sm d-flex align-items-center position-relative overflow-hidden">
        <div class="position-relative z-index-1">
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 mb-3 fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.75rem;">
                <i class="bi bi-bell-fill me-1"></i> Balita at Impormasyon
            </span>
            <h1 class="display-5 fw-extrabold mb-2 text-white">Mga Anunsyo sa Barangay</h1>
            <p class="lead text-white-50 mb-0 max-width-600">
                Manatiling up-to-date sa mga pinakahuling balita, kaganapan, at mahalagang babala para sa kaligtasan at kapakanan ng buong komunidad.
            </p>
        </div>
        <div class="d-none d-lg-block ms-auto">
            <i class="bi bi-megaphone-fill text-white opacity-10" style="font-size: 10rem; transform: rotate(-15deg); display: block;"></i>
        </div>
    </div>

    @if (!items.Any())
    {
        <!-- EMPTY STATE DESIGN -->
        <div class="text-center py-5 my-5 bg-light rounded-4 shadow-sm border">
            <div class="mb-4">
                <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                    <i class="bi bi-megaphone text-muted" style="font-size: 3rem;"></i>
                </div>
            </div>
            <h4 class="fw-bold text-dark">Walang Kasalukuyang Anunsyo</h4>
            <p class="text-muted mb-0 mx-auto" style="max-width: 400px;">Sa ngayon ay wala pang naka-post na bagong balita o paunawa ang barangay admin. Mangyaring bumalik muli mamaya!</p>
        </div>
    }
    else
    {
        <!-- 📊 OVERVIEW STATS -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="ann-stat">
                    <div class="ann-stat__icon" style="background:#e0f2fe; color:#0284c7;"><i class="bi bi-collection"></i></div>
                    <div>
                        <p class="ann-stat__value">@items.Count</p>
                        <p class="ann-stat__label">Total na Anunsyo</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ann-stat">
                    <div class="ann-stat__icon" style="background:#dcfce7; color:#16a34a;"><i class="bi bi-pin-angle-fill"></i></div>
                    <div>
                        <p class="ann-stat__value">@pinnedCount</p>
                        <p class="ann-stat__label">Naka-pin / Featured</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ann-stat">
                    <div class="ann-stat__icon" style="background:#fef3c7; color:#d97706;"><i class="bi bi-tags-fill"></i></div>
                    <div>
                        <p class="ann-stat__value">@categories.Count</p>
                        <p class="ann-stat__label">Mga Kategorya</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ann-stat">
                    <div class="ann-stat__icon" style="background:#f1f5f9; color:#475569;"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <p class="ann-stat__value" style="font-size:1.05rem;">@(latest.HasValue ? latest.Value.ToString("MMM dd, yyyy") : "—")</p>
                        <p class="ann-stat__label">Pinakahuling Update</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🔎 SEARCH + CATEGORY FILTER TOOLBAR -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="annSearch" class="form-control border-start-0" placeholder="Maghanap ng anunsyo, kategorya, o may-akda...">
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        <button type="button" class="filter-chip active" data-filter="all">
                            Lahat <span class="chip-count">@items.Count</span>
                        </button>
                        @foreach (var cat in categories)
                        {
                            var count = items.Count(a => NormalizeCategory(a.Category).Equals(cat, StringComparison.OrdinalIgnoreCase));
                            <button type="button" class="filter-chip" data-filter="@cat">
                                @cat <span class="chip-count">@count</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ANNOUNCEMENTS GRID -->
        <div class="row g-4" id="annGrid">
            @foreach (var announcement in items)
            {
                var badgeClass = BadgeClass(announcement.Category);
                var cat = NormalizeCategory(announcement.Category);
                var searchText = $"{announcement.Title} {announcement.Content} {cat} {announcement.AuthorName}".ToLower();
                var isActive = !announcement.ExpiryDate.HasValue || announcement.ExpiryDate.Value >= DateTime.Now;

                // Larawan: unahin ang naka-store sa database (bukas sa kahit anong device), saka ang legacy URL.
                var hasDbImage = !string.IsNullOrEmpty(announcement.ImageContentType);
                var imgSrc = hasDbImage ? Url.Action("Image", "Announcement", new { id = announcement.AnnouncementId }) : announcement.ImageUrl;
                var hasImage = hasDbImage || !string.IsNullOrEmpty(announcement.ImageUrl);

                <div class="col-md-6 col-lg-4 announcement-col" data-category="@cat" data-search="@searchText">
                    <div class="card h-100 shadow-sm border-0 announcement-card d-flex flex-column @(announcement.IsPinned ? "border-top border-4 border-success" : "border border-light")">

                        <!-- Image Container -->
                        @if (hasImage)
                        {
                            <div class="position-relative overflow-hidden" style="height: 200px;">
                                <img src="@imgSrc" class="w-100 h-100" alt="@announcement.Title" style="object-fit: cover;">
                                <span class="badge @badgeClass rounded-pill px-3 py-1 fw-semibold position-absolute top-0 start-0 m-3" style="font-size: 0.72rem;">@cat</span>
                            </div>
                        }
                        else
                        {
                            <!-- Default placeholder icon -->
                            <div class="bg-light d-flex align-items-center justify-content-center position-relative" style="height: 180px; border-bottom: 1px solid #f1f5f9;">
                                <i class="bi bi-journal-text text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                                <span class="badge @badgeClass rounded-pill px-3 py-1 fw-semibold position-absolute top-0 start-0 m-3" style="font-size: 0.72rem;">@cat</span>
                            </div>
                        }

                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <!-- Status + relative time -->
                                <span class="meta-chip">
                                    <i class="bi bi-clock text-primary"></i> @RelativeTime(announcement.PublishDate)
                                </span>
                                <div class="d-flex align-items-center gap-2">
                                    @if (isActive)
                                    {
                                        <span class="text-success small fw-semibold"><i class="bi bi-broadcast me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fw-semibold"><i class="bi bi-hourglass-bottom me-1"></i>Expired</span>
                                    }
                                    @if (announcement.IsPinned)
                                    {
                                        <span class="text-success small fw-bold"><i class="bi bi-pin-angle-fill me-1"></i>Pinned</span>
                                    }
                                </div>
                            </div>

                            <!-- Title -->
                            <h4 class="card-title fw-bold text-dark mb-2 lh-sm" style="font-size: 1.25rem;">@announcement.Title</h4>

                            <!-- Content Preview (Limitadong mga letra) -->
                            <p class="card-text text-secondary flex-grow-1 lh-base" style="font-size: 0.95rem;">
                                @if (announcement.Content != null && announcement.Content.Length > 120)
                                {
                                    @announcement.Content.Substring(0, 120)
                                    <text>…</text>
                                }
                                else
                                {
                                    @announcement.Content
                                }
                            </p>

                            <!-- Extra meta chips: exact date + validity -->
                            <div class="d-flex flex-wrap gap-2 mb-1">
                                <span class="meta-chip"><i class="bi bi-calendar3"></i> @announcement.PublishDate.ToString("MMM dd, yyyy h:mm tt")</span>
                                @if (announcement.ExpiryDate.HasValue)
                                {
                                    <span class="meta-chip"><i class="bi bi-hourglass-split"></i> Hanggang @announcement.ExpiryDate.Value.ToString("MMM dd, yyyy")</span>
                                }
                                else
                                {
                                    <span class="meta-chip"><i class="bi bi-infinity"></i> Walang expiration</span>
                                }
                            </div>

                            <!-- DETAILS BUTTON (Triggering the Modal) -->
                            <button type="button" class="btn btn-outline-primary btn-sm w-100 rounded-3 my-3 py-2 fw-semibold"
                                    data-bs-toggle="modal"
                                    data-bs-target="#announcementModal-@announcement.AnnouncementId">
                                <i class="bi bi-eye me-1"></i> View Details
                            </button>

                            <!-- Footer Section -->
                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center text-muted" style="font-size: 0.82rem;">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person-circle me-1 text-secondary"></i>
                                    <span class="fw-medium text-dark ms-1 text-truncate" title="@announcement.AuthorName" style="max-width: 160px;">
                                        @(string.IsNullOrEmpty(announcement.AuthorName) ? "Admin" : announcement.AuthorName)
                                    </span>
                                </div>
                                <span class="badge @badgeClass rounded-pill px-2 py-1 fw-semibold" style="font-size: 0.7rem;">@cat</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- 🚫 NO SEARCH RESULTS STATE -->
        <div id="annNoResults" class="text-center py-5 my-4 bg-light rounded-4 border" style="display:none;">
            <i class="bi bi-search text-muted" style="font-size: 2.5rem; opacity:.4;"></i>
            <h5 class="fw-bold text-dark mt-3 mb-1">Walang tumugmang anunsyo</h5>
            <p class="text-muted mb-0">Subukang baguhin ang paghahanap o pumili ng ibang kategorya.</p>
        </div>

        <!-- BOOTSTRAP MODALS PARA SA DETALYE NG BAWAT ANUNSYO -->
        @foreach (var announcement in items)
        {
            var badgeClass = BadgeClass(announcement.Category);
            var cat = NormalizeCategory(announcement.Category);
            var isActive = !announcement.ExpiryDate.HasValue || announcement.ExpiryDate.Value >= DateTime.Now;
            var hasDbImage = announcement.ImageData != null && announcement.ImageData.Length > 0;
            var imgSrc = hasDbImage ? Url.Action("Image", "Announcement", new { id = announcement.AnnouncementId }) : announcement.ImageUrl;
            var hasImage = hasDbImage || !string.IsNullOrEmpty(announcement.ImageUrl);

            <div class="modal fade" id="announcementModal-@announcement.AnnouncementId" tabindex="-1" aria-labelledby="modalLabel-@announcement.AnnouncementId" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow rounded-4">
                        <div class="modal-header border-bottom-0 pb-0">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @badgeClass rounded-pill px-3 py-1-5 fw-semibold ms-2" style="font-size: 0.75rem;">@cat</span>
                                @if (announcement.IsPinned)
                                {
                                    <span class="text-success small fw-bold"><i class="bi bi-pin-angle-fill me-1"></i>Pinned</span>
                                }
                                @if (isActive)
                                {
                                    <span class="text-success small fw-semibold"><i class="bi bi-broadcast me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="text-muted small fw-semibold"><i class="bi bi-hourglass-bottom me-1"></i>Expired</span>
                                }
                            </div>
                            <button type="button" class="btn-close me-2" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body px-4 py-3">
                            <!-- Modal Title -->
                            <h3 class="fw-bold text-dark mb-3" id="modalLabel-@announcement.AnnouncementId">@announcement.Title</h3>

                            <!-- Modal Image -->
                            @if (hasImage)
                            {
                                <div class="mb-4 rounded-3 overflow-hidden" style="max-height: 380px;">
                                    <img src="@imgSrc" class="w-100 h-100" style="object-fit: cover;" alt="@announcement.Title">
                                </div>
                            }

                            <!-- Modal Meta Info -->
                            <div class="row g-3 mb-4 pb-3 border-bottom">
                                <div class="col-sm-6">
                                    <div class="meta-chip w-100"><i class="bi bi-calendar3 text-primary"></i>
                                        <span><strong>Petsa:</strong> @announcement.PublishDate.ToString("MMMM dd, yyyy h:mm tt")</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="meta-chip w-100"><i class="bi bi-person-circle text-secondary"></i>
                                        <span><strong>May-akda:</strong> @(string.IsNullOrEmpty(announcement.AuthorName) ? "Admin" : announcement.AuthorName)</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="meta-chip w-100"><i class="bi bi-hourglass-split text-warning"></i>
                                        <span><strong>Balido hanggang:</strong> @(announcement.ExpiryDate.HasValue ? announcement.ExpiryDate.Value.ToString("MMMM dd, yyyy") : "Walang expiration")</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="meta-chip w-100"><i class="bi bi-clock-history text-info"></i>
                                        <span><strong>Na-post:</strong> @RelativeTime(announcement.PublishDate)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal Content (Buong Teksto) -->
                            <p class="text-secondary lh-lg" style="font-size: 1.05rem; white-space: pre-line;">@announcement.Content</p>
                        </div>
                        <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="button" class="btn btn-secondary px-4 py-2 rounded-3" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const search = document.getElementById('annSearch');
            const chips = document.querySelectorAll('.filter-chip');
            const cols = document.querySelectorAll('.announcement-col');
            const noResults = document.getElementById('annNoResults');
            if (!cols.length) return;

            let activeCat = 'all';

            function apply() {
                const q = (search.value || '').toLowerCase().trim();
                let visible = 0;
                cols.forEach(function (col) {
                    const cat = (col.getAttribute('data-category') || '').toLowerCase();
                    const text = col.getAttribute('data-search') || '';
                    const matchCat = activeCat === 'all' || cat === activeCat.toLowerCase();
                    const matchText = !q || text.indexOf(q) !== -1;
                    const show = matchCat && matchText;
                    col.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
            }

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    chips.forEach(function (c) { c.classList.remove('active'); });
                    chip.classList.add('active');
                    activeCat = chip.getAttribute('data-filter');
                    apply();
                });
            });

            if (search) search.addEventListener('input', apply);
        });
    </script>
}
